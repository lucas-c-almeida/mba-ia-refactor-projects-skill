    {"id": "sec-post-admin-reset-db-anonimo", "method": "POST", "path": "/admin/reset-db", "destructive": true, "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-post-pedidos-quantidade-negativa", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": -5}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-pedidos-item-sem-quantidade", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-produtos-preco-texto", "method": "POST", "path": "/produtos", "body": {"nome": "Item", "preco": "x", "estoque": 1}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-get-produtos-busca-preco-min-texto", "method": "GET", "path": "/produtos/busca?preco_min=abc", "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-login-corpo-null", "method": "POST", "path": "/login", "rawBody": "null", "headers": {"Content-Type": "application/json"}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-login-sqli", "method": "POST", "path": "/login", "body": {"email": "' OR '1'='1' --", "senha": "x"}, "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "sec-get-produtos-busca-sqli", "method": "GET", "path": "/produtos/busca?q=abc%27))", "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "get-produtos-busca-vazia"}
  ]
