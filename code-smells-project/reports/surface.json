{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-root", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "list-produtos", "method": "GET", "path": "/produtos"},
    {"id": "list-produtos-cors", "method": "GET", "path": "/produtos", "headers": {"Origin": "http://example.test"}},
    {"id": "preflight-produtos", "method": "OPTIONS", "path": "/produtos", "headers": {"Origin": "http://example.test", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "Content-Type"}},
    {"id": "search-produtos", "method": "GET", "path": "/produtos/busca?q=Mouse&categoria=informatica&preco_min=10&preco_max=1000"},
    {"id": "search-produtos-empty-query", "method": "GET", "path": "/produtos/busca"},
    {"id": "get-produto", "method": "GET", "path": "/produtos/1"},
    {"id": "get-produto-missing", "method": "GET", "path": "/produtos/9999"},
    {"id": "create-produto", "method": "POST", "path": "/produtos", "body": {"nome": "Produto Teste", "descricao": "desc", "preco": 10.5, "estoque": 5, "categoria": "livros"}},
    {"id": "create-produto-apostrophe", "method": "POST", "path": "/produtos", "body": {"nome": "Livro O'Reilly", "descricao": "manual d'uso", "preco": 99.9, "estoque": 3, "categoria": "livros"}},
    {"id": "create-produto-missing-name", "method": "POST", "path": "/produtos", "body": {"preco": 1, "estoque": 1}},
    {"id": "create-produto-bad-category", "method": "POST", "path": "/produtos", "body": {"nome": "Xyz", "preco": 1, "estoque": 1, "categoria": "nope"}},
    {"id": "create-produto-negative-price", "method": "POST", "path": "/produtos", "body": {"nome": "Xyz", "preco": -1, "estoque": 1}},
    {"id": "update-produto", "method": "PUT", "path": "/produtos/2", "body": {"nome": "Mouse Wireless", "descricao": "Mouse sem fio", "preco": 89.9, "estoque": 50, "categoria": "informatica"}},
    {"id": "update-produto-missing", "method": "PUT", "path": "/produtos/9999", "body": {"nome": "X", "preco": 1, "estoque": 1}},
    {"id": "update-produto-no-price", "method": "PUT", "path": "/produtos/2", "body": {"nome": "Mouse", "estoque": 1}},
    {"id": "delete-produto-missing", "method": "DELETE", "path": "/produtos/9999"},
    {"id": "list-usuarios", "method": "GET", "path": "/usuarios"},
    {"id": "get-usuario", "method": "GET", "path": "/usuarios/1"},
    {"id": "get-usuario-missing", "method": "GET", "path": "/usuarios/9999"},
    {"id": "create-usuario", "method": "POST", "path": "/usuarios", "body": {"nome": "Novo Usuario", "email": "novo@email.com", "senha": "segredo1"}},
    {"id": "create-usuario-empty", "method": "POST", "path": "/usuarios", "body": {}},
    {"id": "create-usuario-missing-fields", "method": "POST", "path": "/usuarios", "body": {"nome": "Sem Email"}},
    {"id": "login-ok", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "senha": "123456"}},
    {"id": "login-new-user", "method": "POST", "path": "/login", "body": {"email": "novo@email.com", "senha": "segredo1"}},
    {"id": "login-wrong", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "senha": "errada"}},
    {"id": "login-missing", "method": "POST", "path": "/login", "body": {"email": ""}},
    {"id": "create-pedido", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 1}, {"produto_id": 2, "quantidade": 2}]}},
    {"id": "create-pedido-no-items", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": []}},
    {"id": "create-pedido-no-user", "method": "POST", "path": "/pedidos", "body": {"itens": [{"produto_id": 1, "quantidade": 1}]}},
    {"id": "create-pedido-unknown-product", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 9999, "quantidade": 1}]}},
    {"id": "create-pedido-no-stock", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 100000}]}},
    {"id": "list-pedidos", "method": "GET", "path": "/pedidos"},
    {"id": "list-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/2"},
    {"id": "list-pedidos-usuario-none", "method": "GET", "path": "/pedidos/usuario/9999"},
    {"id": "update-status-pedido", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "aprovado"}},
    {"id": "update-status-pedido-invalid", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "voando"}},
    {"id": "relatorio-vendas", "method": "GET", "path": "/relatorios/vendas"},
    {"id": "admin-query-select", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT COUNT(*) AS n FROM produtos"}},
    {"id": "admin-query-empty", "method": "POST", "path": "/admin/query", "body": {}},
    {"id": "admin-query-array-body", "method": "POST", "path": "/admin/query", "rawBody": "[]"},
    {"id": "not-found-route", "method": "GET", "path": "/rota-inexistente"},
    {"id": "delete-produto", "method": "DELETE", "path": "/produtos/10", "destructive": true},
    {"id": "admin-reset-db", "method": "POST", "path": "/admin/reset-db", "destructive": true},
    {"id": "search-produtos-quote", "method": "GET", "path": "/produtos/busca?categoria=%27", "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "search-produtos"},
    {"id": "login-sql-injection", "method": "POST", "path": "/login", "body": {"email": "' OR '1'='1' --", "senha": "x"}, "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "create-pedido-negative-qty", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 3, "quantidade": -5}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "create-pedido-unknown-user", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 9999, "itens": [{"produto_id": 1, "quantidade": 1}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "create-produto-string-price", "method": "POST", "path": "/produtos", "body": {"nome": "Xyz", "preco": "abc", "estoque": 1}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "login-null-body", "method": "POST", "path": "/login", "rawBody": "null", "kind": "security", "finding": "AP-09", "expect": "rejected"},
    {"id": "update-produto-bad-category", "method": "PUT", "path": "/produtos/3", "body": {"nome": "Teclado Mecânico", "preco": 299.9, "estoque": 30, "categoria": "nope"}, "kind": "security", "finding": "AP-12", "expect": "rejected"},
    {"id": "create-pedido-oversell-duplicate-lines", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 6, "quantidade": 5}, {"produto_id": 6, "quantidade": 5}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "create-usuario-duplicate-email", "method": "POST", "path": "/usuarios", "body": {"nome": "Duplicado", "email": "joao@email.com", "senha": "outra1"}, "kind": "security", "finding": "AP-20", "expect": "rejected"}
  ]
}
