{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-index", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "list-produtos", "method": "GET", "path": "/produtos"},
    {"id": "list-produtos-cors", "method": "GET", "path": "/produtos", "headers": {"Origin": "http://client.example"}},
    {"id": "preflight-produtos", "method": "OPTIONS", "path": "/produtos", "headers": {"Origin": "http://client.example", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "Content-Type"}},
    {"id": "busca-produtos", "method": "GET", "path": "/produtos/busca?q=Mouse&categoria=informatica&preco_min=10&preco_max=500"},
    {"id": "busca-produtos-vazia", "method": "GET", "path": "/produtos/busca"},
    {"id": "get-produto", "method": "GET", "path": "/produtos/1"},
    {"id": "get-produto-404", "method": "GET", "path": "/produtos/9999"},
    {"id": "create-produto", "method": "POST", "path": "/produtos", "body": {"nome": "Produto Teste", "descricao": "d", "preco": 10.5, "estoque": 3, "categoria": "livros"}},
    {"id": "create-produto-sem-nome", "method": "POST", "path": "/produtos", "body": {"preco": 10, "estoque": 1}},
    {"id": "create-produto-categoria-invalida", "method": "POST", "path": "/produtos", "body": {"nome": "Produto X", "preco": 10, "estoque": 1, "categoria": "brinquedos"}},
    {"id": "create-produto-preco-negativo", "method": "POST", "path": "/produtos", "body": {"nome": "Produto X", "preco": -1, "estoque": 1}},
    {"id": "update-produto", "method": "PUT", "path": "/produtos/2", "body": {"nome": "Mouse Wireless", "descricao": "Mouse sem fio", "preco": 89.9, "estoque": 50, "categoria": "informatica"}},
    {"id": "update-produto-404", "method": "PUT", "path": "/produtos/9999", "body": {"nome": "X Y", "preco": 1, "estoque": 1}},
    {"id": "update-produto-sem-estoque", "method": "PUT", "path": "/produtos/2", "body": {"nome": "Mouse Wireless", "preco": 89.9}},
    {"id": "delete-produto-404", "method": "DELETE", "path": "/produtos/9999"},
    {"id": "list-usuarios", "method": "GET", "path": "/usuarios"},
    {"id": "get-usuario", "method": "GET", "path": "/usuarios/1"},
    {"id": "get-usuario-404", "method": "GET", "path": "/usuarios/9999"},
    {"id": "create-usuario", "method": "POST", "path": "/usuarios", "body": {"nome": "Ana Teste", "email": "ana@teste.com", "senha": "{{env:NEW_USER_PASSWORD}}"}},
    {"id": "create-usuario-incompleto", "method": "POST", "path": "/usuarios", "body": {"nome": "Ana Teste"}},
    {"id": "login", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "senha": "{{env:LOGIN_PASSWORD}}"}},
    {"id": "login-usuario-novo", "method": "POST", "path": "/login", "body": {"email": "ana@teste.com", "senha": "{{env:NEW_USER_PASSWORD}}"}},
    {"id": "login-senha-errada", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "senha": "senha-que-nao-confere"}},
    {"id": "login-incompleto", "method": "POST", "path": "/login", "body": {"email": "joao@email.com"}},
    {"id": "create-pedido", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 1}, {"produto_id": 2, "quantidade": 3}]}},
    {"id": "create-pedido-produto-404", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 9999, "quantidade": 1}]}},
    {"id": "create-pedido-sem-estoque", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 6, "quantidade": 1000}]}},
    {"id": "create-pedido-sem-itens", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": []}},
    {"id": "create-pedido-sem-usuario", "method": "POST", "path": "/pedidos", "body": {"itens": [{"produto_id": 1, "quantidade": 1}]}},
    {"id": "list-pedidos", "method": "GET", "path": "/pedidos"},
    {"id": "list-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/2"},
    {"id": "list-pedidos-usuario-vazio", "method": "GET", "path": "/pedidos/usuario/3"},
    {"id": "update-status-pedido", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "aprovado"}},
    {"id": "update-status-pedido-invalido", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "perdido"}},
    {"id": "relatorio-vendas-operador", "method": "GET", "path": "/relatorios/vendas", "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"}},
    {"id": "get-rota-inexistente", "method": "GET", "path": "/nao-existe"},

    {"id": "value-usuarios-senha-mascarada", "method": "GET", "path": "/usuarios", "kind": "value",
     "assert": [{"path": "$.dados[*].senha", "matches": "^\\*+$"}]},
    {"id": "value-usuario-senha-mascarada", "method": "GET", "path": "/usuarios/1", "kind": "value",
     "assert": [{"path": "$.dados.senha", "matches": "^\\*+$"}, {"path": "$.dados.email", "sameAsBaseline": true}]},
    {"id": "value-health-segredo-mascarado", "method": "GET", "path": "/health", "kind": "value",
     "assert": [{"path": "$.secret_key", "matches": "^\\*+$"}, {"path": "$.debug", "equals": false}, {"path": "$.db_path", "sameAsBaseline": true}, {"path": "$.ambiente", "sameAsBaseline": true}]},
    {"id": "value-pedido-total", "method": "POST", "path": "/pedidos", "kind": "value",
     "body": {"usuario_id": 3, "itens": [{"produto_id": 5, "quantidade": 2}]},
     "assert": [{"path": "$.dados.total", "sameAsBaseline": true}]},
    {"id": "value-relatorio-vendas", "method": "GET", "path": "/relatorios/vendas", "kind": "value",
     "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"},
     "assert": [{"path": "$.dados.total_pedidos", "sameAsBaseline": true}, {"path": "$.dados.faturamento_bruto", "sameAsBaseline": true}, {"path": "$.dados.desconto_aplicavel", "sameAsBaseline": true}, {"path": "$.dados.faturamento_liquido", "sameAsBaseline": true}, {"path": "$.dados.pedidos_aprovados", "sameAsBaseline": true}]},
    {"id": "value-pedidos-usuario-itens", "method": "GET", "path": "/pedidos/usuario/2", "kind": "value",
     "assert": [{"path": "$.dados[*].itens[*].produto_nome", "sameAsBaseline": true}, {"path": "$.dados[*].total", "sameAsBaseline": true}]},

    {"id": "delete-produto", "method": "DELETE", "path": "/produtos/3", "destructive": true},

    {"id": "sec-admin-query", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT id FROM produtos"},
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-admin-reset", "method": "POST", "path": "/admin/reset-db",
     "kind": "security", "finding": "AP-04", "expect": "rejected", "destructive": true},
    {"id": "sec-relatorio-anonimo", "method": "GET", "path": "/relatorios/vendas",
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-login-sqli", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com' --", "senha": "qualquer"},
     "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "sec-busca-aspas", "method": "GET", "path": "/produtos/busca?q=%27",
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "busca-produtos"},
    {"id": "sec-busca-aspas-parentese", "method": "GET", "path": "/produtos/busca?q=x%27%29",
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "busca-produtos"},
    {"id": "sec-create-produto-aspas", "method": "POST", "path": "/produtos", "body": {"nome": "Livro O'Reilly", "descricao": "d", "preco": 50, "estoque": 2, "categoria": "livros"},
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "create-produto"},
    {"id": "sec-pedido-quantidade-negativa", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 4, "quantidade": -5}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-pedido-usuario-inexistente", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 999999, "itens": [{"produto_id": 4, "quantidade": 1}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-login-corpo-nulo", "method": "POST", "path": "/login", "rawBody": "null",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-update-produto-categoria-invalida", "method": "PUT", "path": "/produtos/7", "body": {"nome": "Webcam HD", "preco": 249.9, "estoque": 20, "categoria": "brinquedos"},
     "kind": "security", "finding": "AP-12", "expect": "rejected"},
    {"id": "sec-status-pedido-inexistente", "method": "PUT", "path": "/pedidos/999999/status", "body": {"status": "aprovado"},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-update-produto-nome-curto", "method": "PUT", "path": "/produtos/7", "body": {"nome": "W", "preco": 249.9, "estoque": 20, "categoria": "informatica"},
     "kind": "security", "finding": "AP-12", "expect": "rejected"},

    {"id": "rob-busca-produtos", "method": "GET", "path": "/produtos/busca?q=Mouse&categoria=informatica&preco_min=10&preco_max=500",
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "query", "name": "q", "type": "string"}, {"in": "query", "name": "categoria", "type": "string"},
                {"in": "query", "name": "preco_min", "type": "number"}, {"in": "query", "name": "preco_max", "type": "number"}]},
    {"id": "rob-get-produto", "method": "GET", "path": "/produtos/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 1}]},
    {"id": "rob-create-produto", "method": "POST", "path": "/produtos", "kind": "robustness", "finding": "AP-11",
     "body": {"nome": "Produto Rob", "descricao": "d", "preco": 10.5, "estoque": 3, "categoria": "livros"},
     "fields": [{"in": "body", "name": "nome", "type": "string"}, {"in": "body", "name": "descricao", "type": "string"},
                {"in": "body", "name": "preco", "type": "number"}, {"in": "body", "name": "estoque", "type": "integer"},
                {"in": "body", "name": "categoria", "type": "string"}]},
    {"id": "rob-update-produto", "method": "PUT", "path": "/produtos/{id}", "kind": "robustness", "finding": "AP-11",
     "body": {"nome": "Hub USB", "descricao": "Hub USB 3.0 7 portas", "preco": 79.9, "estoque": 40, "categoria": "informatica"},
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 8},
                {"in": "body", "name": "nome", "type": "string"}, {"in": "body", "name": "descricao", "type": "string"},
                {"in": "body", "name": "preco", "type": "number"}, {"in": "body", "name": "estoque", "type": "integer"},
                {"in": "body", "name": "categoria", "type": "string"}]},
    {"id": "rob-delete-produto", "method": "DELETE", "path": "/produtos/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 9999}]},
    {"id": "rob-get-usuario", "method": "GET", "path": "/usuarios/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 1}]},
    {"id": "rob-create-usuario", "method": "POST", "path": "/usuarios", "kind": "robustness", "finding": "AP-11",
     "body": {"nome": "Rob Teste", "email": "rob@teste.com", "senha": "{{env:NEW_USER_PASSWORD}}"},
     "fields": [{"in": "body", "name": "nome", "type": "string"}, {"in": "body", "name": "email", "type": "string"},
                {"in": "body", "name": "senha", "type": "string"}]},
    {"id": "rob-login", "method": "POST", "path": "/login", "kind": "robustness", "finding": "AP-11",
     "body": {"email": "joao@email.com", "senha": "{{env:LOGIN_PASSWORD}}"},
     "fields": [{"in": "body", "name": "email", "type": "string"}, {"in": "body", "name": "senha", "type": "string"}]},
    {"id": "rob-create-pedido", "method": "POST", "path": "/pedidos", "kind": "robustness", "finding": "AP-11",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 5, "quantidade": 1}]},
     "fields": [{"in": "body", "name": "usuario_id", "type": "integer"}, {"in": "body", "name": "itens", "type": "array"}]},
    {"id": "rob-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/{usuario_id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "usuario_id", "type": "integer", "value": 2}]},
    {"id": "rob-update-status-pedido", "method": "PUT", "path": "/pedidos/{pedido_id}/status", "kind": "robustness", "finding": "AP-11",
     "body": {"status": "enviado"},
     "fields": [{"in": "path", "name": "pedido_id", "type": "integer", "value": 1}, {"in": "body", "name": "status", "type": "string"}]},
    {"id": "rob-relatorio-vendas", "method": "GET", "path": "/relatorios/vendas", "kind": "robustness", "finding": "AP-11",
     "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"},
     "fields": [{"in": "header", "name": "X-Operator-Token", "type": "string"}]}
  ]
}
