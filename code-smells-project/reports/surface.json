    {"id": "get-usuarios-9999", "method": "GET", "path": "/usuarios/9999"},
    {"id": "post-usuarios", "method": "POST", "path": "/usuarios", "body": {"nome": "Teste", "email": "teste@x.com", "senha": "abc"}},
