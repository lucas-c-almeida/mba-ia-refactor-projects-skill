{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-index", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "health-values", "method": "GET", "path": "/health", "kind": "value",
     "assert": [{"path": "$.secret_key", "matches": "^\\*+$"},
                {"path": "$.status", "equals": "ok"}]},
    {"id": "list-products", "method": "GET", "path": "/produtos"},
    {"id": "list-products-cors", "method": "GET", "path": "/produtos",
     "headers": {"Origin": "http://client.example"}},
    {"id": "preflight-products-cors", "method": "OPTIONS", "path": "/produtos",
     "headers": {"Origin": "http://client.example", "Access-Control-Request-Method": "POST",
                 "Access-Control-Request-Headers": "Content-Type"}},
    {"id": "search-products", "method": "GET",
     "path": "/produtos/busca?q=Mouse&categoria=informatica&preco_min=10&preco_max=500"},
    {"id": "search-products-empty", "method": "GET", "path": "/produtos/busca"},
    {"id": "search-products-price-zero", "method": "GET", "path": "/produtos/busca?preco_min=0&preco_max=100"},
    {"id": "search-injection-values", "method": "GET",
     "path": "/produtos/busca?q=%27%20OR%201%3D1%20--", "kind": "value",
     "assert": [{"path": "$.total", "equals": 0}]},
    {"id": "search-category-injection-values", "method": "GET",
     "path": "/produtos/busca?categoria=%27%20OR%20%271%27%3D%271", "kind": "value",
     "assert": [{"path": "$.total", "equals": 0}]},
    {"id": "get-product", "method": "GET", "path": "/produtos/1"},
    {"id": "get-product-missing", "method": "GET", "path": "/produtos/9999"},
    {"id": "create-product", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto Teste", "descricao": "d", "preco": 10.5, "estoque": 3, "categoria": "geral"}},
    {"id": "create-product-missing-name", "method": "POST", "path": "/produtos",
     "body": {"preco": 10.5, "estoque": 3}},
    {"id": "create-product-negative-price", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto X", "preco": -1, "estoque": 3}},
    {"id": "create-product-bad-category", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto X", "preco": 1, "estoque": 3, "categoria": "invalida"}},
    {"id": "update-product", "method": "PUT", "path": "/produtos/11",
     "body": {"nome": "Produto Teste 2", "descricao": "d", "preco": 11, "estoque": 4, "categoria": "geral"}},
    {"id": "update-product-missing", "method": "PUT", "path": "/produtos/9999",
     "body": {"nome": "Produto Teste 2", "preco": 11, "estoque": 4}},
    {"id": "update-product-missing-price", "method": "PUT", "path": "/produtos/11",
     "body": {"nome": "Produto Teste 2", "estoque": 4}},
    {"id": "delete-product", "method": "DELETE", "path": "/produtos/11"},
    {"id": "delete-product-missing", "method": "DELETE", "path": "/produtos/9999"},
    {"id": "list-users", "method": "GET", "path": "/usuarios"},
    {"id": "list-users-values", "method": "GET", "path": "/usuarios", "kind": "value",
     "assert": [{"path": "$.dados[*].senha", "matches": "^\\*+$"},
                {"path": "$.dados[*].email", "sameAsBaseline": true}]},
    {"id": "get-user", "method": "GET", "path": "/usuarios/1"},
    {"id": "get-user-values", "method": "GET", "path": "/usuarios/1", "kind": "value",
     "assert": [{"path": "$.dados.senha", "matches": "^\\*+$"}]},
    {"id": "get-user-missing", "method": "GET", "path": "/usuarios/9999"},
    {"id": "create-user", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Novo", "email": "novo@x.com", "senha": "{{env:PROBE_USER_PASSWORD}}"}},
    {"id": "create-user-missing-fields", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Novo"}},
    {"id": "login-ok", "method": "POST", "path": "/login",
     "body": {"email": "novo@x.com", "senha": "{{env:PROBE_USER_PASSWORD}}"}},
    {"id": "login-ok-values", "method": "POST", "path": "/login",
     "body": {"email": "novo@x.com", "senha": "{{env:PROBE_USER_PASSWORD}}"}, "kind": "value",
     "assert": [{"path": "$.sucesso", "equals": true}, {"path": "$.dados.email", "equals": "novo@x.com"},
                {"path": "$.dados.senha", "absent": true}]},
    {"id": "login-wrong-password", "method": "POST", "path": "/login",
     "body": {"email": "novo@x.com", "senha": "errada"}},
    {"id": "login-missing-fields", "method": "POST", "path": "/login",
     "body": {"email": "novo@x.com"}},
    {"id": "create-order", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 1}, {"produto_id": 2, "quantidade": 2}]}},
    {"id": "create-order-no-items", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": []}},
    {"id": "create-order-unknown-product", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 9999, "quantidade": 1}]}},
    {"id": "create-order-no-stock", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 6, "quantidade": 1000}]}},
    {"id": "list-orders", "method": "GET", "path": "/pedidos"},
    {"id": "list-orders-values", "method": "GET", "path": "/pedidos", "kind": "value",
     "assert": [{"path": "$.dados[*].total", "sameAsBaseline": true},
                {"path": "$.dados[*].itens[*].preco_unitario", "sameAsBaseline": true},
                {"path": "$.dados[*].itens[*].produto_nome", "sameAsBaseline": true}]},
    {"id": "list-user-orders", "method": "GET", "path": "/pedidos/usuario/2"},
    {"id": "list-user-orders-empty", "method": "GET", "path": "/pedidos/usuario/9999"},
    {"id": "update-order-status", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "aprovado"}},
    {"id": "update-order-status-invalid", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "voando"}},
    {"id": "list-products-values", "method": "GET", "path": "/produtos", "kind": "value",
     "assert": [{"path": "$.dados[*].preco", "sameAsBaseline": true},
                {"path": "$.dados[*].estoque", "sameAsBaseline": true}]},
    {"id": "sales-report-operator", "method": "GET", "path": "/relatorios/vendas",
     "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"}},
    {"id": "sales-report-operator-values", "method": "GET", "path": "/relatorios/vendas",
     "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"}, "kind": "value",
     "assert": [{"path": "$.dados.faturamento_bruto", "sameAsBaseline": true},
                {"path": "$.dados.desconto_aplicavel", "sameAsBaseline": true},
                {"path": "$.dados.faturamento_liquido", "sameAsBaseline": true},
                {"path": "$.dados.ticket_medio", "sameAsBaseline": true},
                {"path": "$.dados.total_pedidos", "sameAsBaseline": true},
                {"path": "$.dados.pedidos_aprovados", "sameAsBaseline": true}]},

    {"id": "sec-sales-report-anonymous", "method": "GET", "path": "/relatorios/vendas",
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-admin-query", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT 1 AS n"},
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-admin-reset", "method": "POST", "path": "/admin/reset-db", "body": null,
     "kind": "security", "finding": "AP-04", "expect": "rejected", "destructive": true},
    {"id": "sec-login-injection", "method": "POST", "path": "/login",
     "body": {"email": "' OR '1'='1' --", "senha": "x"},
     "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "sec-search-quote", "method": "GET", "path": "/produtos/busca?q=%27%29",
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "search-products"},
    {"id": "sec-login-seeded-admin", "method": "POST", "path": "/login",
     "body": {"email": "admin@loja.com", "senha": "{{env:SEED_LEGACY_ADMIN_PASSWORD}}"},
     "kind": "security", "finding": "AP-01", "expect": "rejected"},
    {"id": "sec-update-product-bad-category", "method": "PUT", "path": "/produtos/2",
     "body": {"nome": "Mouse Wireless", "preco": 89.9, "estoque": 50, "categoria": "invalida"},
     "kind": "security", "finding": "AP-12", "expect": "rejected"},
    {"id": "sec-update-product-short-name", "method": "PUT", "path": "/produtos/2",
     "body": {"nome": "M", "preco": 89.9, "estoque": 50, "categoria": "informatica"},
     "kind": "security", "finding": "AP-12", "expect": "rejected"},
    {"id": "sec-order-negative-quantity", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 3, "quantidade": -5}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-order-missing-quantity", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 3}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-order-string-quantity", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 3, "quantidade": "2"}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-order-item-not-object", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": ["x"]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-order-string-product", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": "1 OR 1=1", "quantidade": 1}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-order-unknown-user", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 999999, "itens": [{"produto_id": 3, "quantidade": 1}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-register-duplicate-email", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Outro", "email": "admin@loja.com", "senha": "{{env:PROBE_USER_PASSWORD}}"},
     "kind": "security", "finding": "AP-20", "expect": "rejected"},
    {"id": "sec-login-null-body", "method": "POST", "path": "/login", "rawBody": "null",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-status-null-body", "method": "PUT", "path": "/pedidos/1/status", "rawBody": "null",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-search-bad-price", "method": "GET", "path": "/produtos/busca?preco_min=abc",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},

    {"id": "rb-create-product", "method": "POST", "path": "/produtos",
     "body": {"nome": "Robusto", "descricao": "d", "preco": 5.5, "estoque": 2, "categoria": "geral"},
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "body", "name": "nome", "type": "string"},
                {"in": "body", "name": "descricao", "type": "string"},
                {"in": "body", "name": "preco", "type": "number"},
                {"in": "body", "name": "estoque", "type": "integer"},
                {"in": "body", "name": "categoria", "type": "string"}]},
    {"id": "rb-update-product", "method": "PUT", "path": "/produtos/{id}",
     "body": {"nome": "Teclado Mecânico", "descricao": "d", "preco": 299.9, "estoque": 30, "categoria": "informatica"},
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 3},
                {"in": "body", "name": "nome", "type": "string"},
                {"in": "body", "name": "descricao", "type": "string"},
                {"in": "body", "name": "preco", "type": "number"},
                {"in": "body", "name": "estoque", "type": "integer"},
                {"in": "body", "name": "categoria", "type": "string"}]},
    {"id": "rb-get-product", "method": "GET", "path": "/produtos/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 1}]},
    {"id": "rb-delete-product", "method": "DELETE", "path": "/produtos/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 9999}]},
    {"id": "rb-search-products", "method": "GET", "path": "/produtos/busca?q=a&categoria=informatica&preco_min=1&preco_max=9000",
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "query", "name": "q", "type": "string"},
                {"in": "query", "name": "categoria", "type": "string"},
                {"in": "query", "name": "preco_min", "type": "number"},
                {"in": "query", "name": "preco_max", "type": "number"}]},
    {"id": "rb-get-user", "method": "GET", "path": "/usuarios/{id}", "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "id", "type": "integer", "value": 1}]},
    {"id": "rb-create-user", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Robusto", "email": "robusto@x.com", "senha": "{{env:PROBE_USER_PASSWORD}}"},
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "body", "name": "nome", "type": "string"},
                {"in": "body", "name": "email", "type": "string"},
                {"in": "body", "name": "senha", "type": "string"}]},
    {"id": "rb-login", "method": "POST", "path": "/login",
     "body": {"email": "novo@x.com", "senha": "{{env:PROBE_USER_PASSWORD}}"},
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "body", "name": "email", "type": "string"},
                {"in": "body", "name": "senha", "type": "string"}]},
    {"id": "rb-create-order", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 3, "itens": [{"produto_id": 5, "quantidade": 1}]},
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "body", "name": "usuario_id", "type": "integer"},
                {"in": "body", "name": "itens", "type": "array"}]},
    {"id": "rb-list-user-orders", "method": "GET", "path": "/pedidos/usuario/{usuario_id}",
     "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "usuario_id", "type": "integer", "value": 2}]},
    {"id": "rb-update-order-status", "method": "PUT", "path": "/pedidos/{pedido_id}/status",
     "body": {"status": "enviado"}, "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "path", "name": "pedido_id", "type": "integer", "value": 1},
                {"in": "body", "name": "status", "type": "string"}]},
    {"id": "rb-sales-report", "method": "GET", "path": "/relatorios/vendas",
     "headers": {"X-Operator-Token": "{{env:OPERATOR_TOKEN}}"}, "kind": "robustness", "finding": "AP-11",
     "fields": [{"in": "header", "name": "X-Operator-Token", "type": "string"}]}
  ]
}
