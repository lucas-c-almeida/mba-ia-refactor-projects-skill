{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-root", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "get-produtos", "method": "GET", "path": "/produtos"},
    {"id": "get-produtos-busca", "method": "GET", "path": "/produtos/busca?q=Mouse"},
    {"id": "get-produtos-busca-filtros", "method": "GET", "path": "/produtos/busca?q=a&categoria=informatica&preco_min=10&preco_max=1000"},
    {"id": "get-produtos-1", "method": "GET", "path": "/produtos/1"},
    {"id": "get-produtos-9999", "method": "GET", "path": "/produtos/9999"},
    {"id": "post-produtos", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto Teste", "descricao": "descricao teste", "preco": 10.5, "estoque": 5, "categoria": "geral"}},
    {"id": "post-produtos-sem-nome", "method": "POST", "path": "/produtos", "body": {"preco": 1, "estoque": 1}},
    {"id": "post-produtos-categoria-invalida", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto Teste", "preco": 1, "estoque": 1, "categoria": "inexistente"}},
    {"id": "put-produtos-1", "method": "PUT", "path": "/produtos/1",
     "body": {"nome": "Notebook Gamer", "descricao": "Notebook potente para jogos", "preco": 5999.99, "estoque": 10, "categoria": "informatica"}},
    {"id": "put-produtos-9999", "method": "PUT", "path": "/produtos/9999",
     "body": {"nome": "x", "preco": 1, "estoque": 1}},
    {"id": "delete-produtos-9999", "method": "DELETE", "path": "/produtos/9999"},
    {"id": "get-usuarios", "method": "GET", "path": "/usuarios"},
    {"id": "get-usuarios-1", "method": "GET", "path": "/usuarios/1"},
    {"id": "get-usuarios-9999", "method": "GET", "path": "/usuarios/9999"},
    {"id": "post-usuarios", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Usuario Teste", "email": "teste@example.com", "senha": "senha-de-teste"}},
    {"id": "post-usuarios-incompleto", "method": "POST", "path": "/usuarios", "body": {"nome": "Sem Email"}},
    {"id": "post-login", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "admin123"}},
    {"id": "post-login-invalido", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "errada"}},
    {"id": "post-login-incompleto", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com"}},
    {"id": "post-pedidos", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 2, "quantidade": 1}]}},
    {"id": "post-pedidos-vazio", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": []}},
    {"id": "post-pedidos-produto-inexistente", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 9999, "quantidade": 1}]}},
    {"id": "post-pedidos-estoque-insuficiente", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 2, "quantidade": 99999}]}},
    {"id": "get-pedidos", "method": "GET", "path": "/pedidos"},
    {"id": "get-pedidos-usuario-2", "method": "GET", "path": "/pedidos/usuario/2"},
    {"id": "put-pedidos-1-status", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "aprovado"}},
    {"id": "put-pedidos-1-status-invalido", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "inexistente"}},
    {"id": "get-relatorios-vendas-operador", "method": "GET", "path": "/relatorios/vendas",
     "headers": {"X-Operator-Token": "replay-operator-token"}},
    {"id": "get-rota-inexistente", "method": "GET", "path": "/nao-existe"},
    {"id": "get-cors-produtos", "method": "GET", "path": "/produtos", "headers": {"Origin": "http://example.com"}},
    {"id": "options-cors-produtos", "method": "OPTIONS", "path": "/produtos",
     "headers": {"Origin": "http://example.com", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type"}},
    {"id": "get-cors-path-maiusculo", "method": "GET", "path": "/PRODUTOS", "headers": {"Origin": "http://example.com"}},
    {"id": "get-cors-path-com-mais", "method": "GET", "path": "/produtos+x", "headers": {"Origin": "http://example.com"}},
    {"id": "delete-produtos-10", "method": "DELETE", "path": "/produtos/10", "destructive": true},
    {"id": "sec-login-sqli", "method": "POST", "path": "/login",
     "body": {"email": "' OR '1'='1' --", "senha": "x"},
     "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "sec-busca-aspa", "method": "GET", "path": "/produtos/busca?q=a%27%29%29--",
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "get-produtos-busca"},
    {"id": "sec-post-produtos-aspa", "method": "POST", "path": "/produtos",
     "body": {"nome": "O'Brien Ltda", "descricao": "descricao teste", "preco": 1.0, "estoque": 1, "categoria": "geral"},
     "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "post-produtos"},
    {"id": "sec-post-produtos-preco-texto", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto Valido", "preco": "abc", "estoque": 1},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-produtos-json-malformado", "method": "POST", "path": "/produtos",
     "rawBody": "{\"nome\": ",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-pedidos-quantidade-negativa", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 2, "quantidade": -1}]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-get-busca-preco-invalido", "method": "GET", "path": "/produtos/busca?preco_min=abc",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-usuarios-duplicado", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Outro Admin", "email": "admin@loja.com", "senha": "outra-senha"},
     "kind": "security", "finding": "AP-20", "expect": "rejected"},
    {"id": "sec-post-admin-query", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT 1"},
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-get-relatorios-vendas-anonimo", "method": "GET", "path": "/relatorios/vendas",
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-get-console", "method": "GET", "path": "/console",
     "kind": "security", "finding": "AP-18", "expect": "rejected"},
    {"id": "sec-post-admin-reset-db", "method": "POST", "path": "/admin/reset-db", "destructive": true,
     "kind": "security", "finding": "AP-04", "expect": "rejected"}
  ]
}
