{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-root", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "get-unknown-route", "method": "GET", "path": "/rota-inexistente"},
    {"id": "get-produtos", "method": "GET", "path": "/produtos"},
    {"id": "get-produtos-origin", "method": "GET", "path": "/produtos", "headers": {"Origin": "http://example.test"}},
    {"id": "get-produtos-origin-uppercase-path", "method": "GET", "path": "/PRODUTOS", "headers": {"Origin": "http://example.test"}},
    {"id": "get-produtos-origin-plus-path", "method": "GET", "path": "/produtos/a+b", "headers": {"Origin": "http://example.test"}},
    {"id": "options-produtos-preflight", "method": "OPTIONS", "path": "/produtos", "headers": {"Origin": "http://example.test", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type"}},
    {"id": "get-produto-1", "method": "GET", "path": "/produtos/1"},
    {"id": "get-produto-missing", "method": "GET", "path": "/produtos/9999"},
    {"id": "search-produtos", "method": "GET", "path": "/produtos/busca?q=Mouse&categoria=informatica&preco_min=10&preco_max=500"},
    {"id": "search-produtos-all", "method": "GET", "path": "/produtos/busca"},
    {"id": "create-produto", "method": "POST", "path": "/produtos", "body": {"nome": "Produto Teste", "descricao": "descricao teste", "preco": 10.5, "estoque": 5, "categoria": "geral"}},
    {"id": "create-produto-empty", "method": "POST", "path": "/produtos", "body": {}},
    {"id": "create-produto-missing-price", "method": "POST", "path": "/produtos", "body": {"nome": "Sem preco"}},
    {"id": "update-produto", "method": "PUT", "path": "/produtos/2", "body": {"nome": "Mouse Atualizado", "descricao": "d", "preco": 95.5, "estoque": 40, "categoria": "informatica"}},
    {"id": "update-produto-empty", "method": "PUT", "path": "/produtos/2", "body": {}},
    {"id": "update-produto-missing", "method": "PUT", "path": "/produtos/9999", "body": {"nome": "Nada", "preco": 1, "estoque": 1}},
    {"id": "delete-produto-missing", "method": "DELETE", "path": "/produtos/9999"},
    {"id": "get-usuarios", "method": "GET", "path": "/usuarios"},
    {"id": "get-usuario-1", "method": "GET", "path": "/usuarios/1"},
    {"id": "get-usuario-missing", "method": "GET", "path": "/usuarios/9999"},
    {"id": "create-usuario", "method": "POST", "path": "/usuarios", "body": {"nome": "Usuario Teste", "email": "teste@loja.com", "senha": "abc12345"}},
    {"id": "create-usuario-incomplete", "method": "POST", "path": "/usuarios", "body": {"nome": "Sem email"}},
    {"id": "login-ok", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "admin123"}},
    {"id": "login-wrong-password", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "errada"}},
    {"id": "login-missing-password", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com"}},
    {"id": "create-pedido", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 1}]}},
    {"id": "create-pedido-no-items", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": []}},
    {"id": "create-pedido-unknown-product", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 9999, "quantidade": 1}]}},
    {"id": "create-pedido-no-stock", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 100000}]}},
    {"id": "get-pedidos", "method": "GET", "path": "/pedidos"},
    {"id": "get-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/2"},
    {"id": "update-pedido-status", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "aprovado"}},
    {"id": "update-pedido-status-invalid", "method": "PUT", "path": "/pedidos/1/status", "body": {"status": "invalido"}},
    {"id": "get-relatorio-vendas-operator", "method": "GET", "path": "/relatorios/vendas", "headers": {"X-Operator-Token": "probe-operator-token"}},
    {"id": "delete-produto", "method": "DELETE", "path": "/produtos/10", "destructive": true},

    {"id": "sec-login-sqli", "method": "POST", "path": "/login", "body": {"email": "' OR '1'='1' --", "senha": "x"}, "kind": "security", "finding": "AP-02", "expect": "rejected"},
    {"id": "sec-search-sqli", "method": "GET", "path": "/produtos/busca?q=x%27%20AND", "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "search-produtos"},
    {"id": "sec-create-produto-quote", "method": "POST", "path": "/produtos", "body": {"nome": "O'Brien Mouse", "descricao": "d", "preco": 10.5, "estoque": 5, "categoria": "geral"}, "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "create-produto"},
    {"id": "sec-create-produto-price-string", "method": "POST", "path": "/produtos", "body": {"nome": "Preco texto", "preco": "abc", "estoque": 1}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-create-produto-malformed-body", "method": "POST", "path": "/produtos", "rawBody": "{\"nome\": ", "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-create-pedido-negative-quantity", "method": "POST", "path": "/pedidos", "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": -5}]}, "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-create-usuario-duplicate-email", "method": "POST", "path": "/usuarios", "body": {"nome": "Duplicado", "email": "admin@loja.com", "senha": "outra"}, "kind": "security", "finding": "AP-20", "expect": "rejected"},
    {"id": "sec-admin-query", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT 1 AS x"}, "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-relatorio-vendas-anonymous", "method": "GET", "path": "/relatorios/vendas", "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-debug-console", "method": "GET", "path": "/console", "kind": "security", "finding": "AP-18", "expect": "rejected"},
    {"id": "sec-admin-reset-db", "method": "POST", "path": "/admin/reset-db", "kind": "security", "finding": "AP-04", "expect": "rejected", "destructive": true}
  ]
}
