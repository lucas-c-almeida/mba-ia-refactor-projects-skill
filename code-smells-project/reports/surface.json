{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    { "id": "home", "method": "GET", "path": "/" },
    { "id": "health", "method": "GET", "path": "/health" },
    { "id": "list-produtos", "method": "GET", "path": "/produtos" },
    { "id": "list-produtos-cors", "method": "GET", "path": "/produtos",
      "headers": { "Origin": "http://example.com" } },
    { "id": "produtos-preflight", "method": "OPTIONS", "path": "/produtos",
      "headers": { "Origin": "http://example.com", "Access-Control-Request-Method": "GET" } },
    { "id": "get-produto", "method": "GET", "path": "/produtos/1" },
    { "id": "get-produto-missing", "method": "GET", "path": "/produtos/9999" },
    { "id": "search-produtos", "method": "GET", "path": "/produtos/busca?q=notebook" },
    { "id": "create-produto", "method": "POST", "path": "/produtos",
      "body": { "nome": "Item Teste", "preco": 10.5, "estoque": 5, "categoria": "geral" } },
    { "id": "create-produto-invalid", "method": "POST", "path": "/produtos", "body": {} },
    { "id": "update-produto", "method": "PUT", "path": "/produtos/11",
      "body": { "nome": "Item Teste Atualizado", "preco": 12.5, "estoque": 4, "categoria": "geral" } },
    { "id": "list-usuarios", "method": "GET", "path": "/usuarios" },
    { "id": "get-usuario", "method": "GET", "path": "/usuarios/1" },
    { "id": "create-usuario", "method": "POST", "path": "/usuarios",
      "body": { "nome": "Teste User", "email": "teste@example.com", "senha": "segredo123" } },
    { "id": "login-ok", "method": "POST", "path": "/login",
      "body": { "email": "admin@loja.com", "senha": "admin123" } },
    { "id": "login-fail", "method": "POST", "path": "/login",
      "body": { "email": "admin@loja.com", "senha": "wrong" } },
    { "id": "create-pedido", "method": "POST", "path": "/pedidos",
      "body": { "usuario_id": 1, "itens": [ { "produto_id": 1, "quantidade": 1 } ] } },
    { "id": "create-pedido-invalid-produto", "method": "POST", "path": "/pedidos",
      "body": { "usuario_id": 1, "itens": [ { "produto_id": 99999, "quantidade": 1 } ] } },
    { "id": "list-pedidos", "method": "GET", "path": "/pedidos" },
    { "id": "list-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/1" },
    { "id": "update-status-pedido", "method": "PUT", "path": "/pedidos/1/status",
      "body": { "status": "aprovado" } },
    { "id": "relatorio-vendas", "method": "GET", "path": "/relatorios/vendas" },
    { "id": "admin-query-benign", "method": "POST", "path": "/admin/query",
      "body": { "sql": "SELECT 1" } },

    { "id": "sqli-search", "method": "GET", "path": "/produtos/busca?q=%27%20OR%20%271%27%3D%271",
      "kind": "security", "finding": "AP-02", "expect": "neutralized", "like": "search-produtos" },
    { "id": "sqli-login", "method": "POST", "path": "/login",
      "body": { "email": "x' OR '1'='1' -- ", "senha": "anything" },
      "kind": "security", "finding": "AP-02", "expect": "rejected" },
    { "id": "sqli-pedido", "method": "POST", "path": "/pedidos",
      "body": { "usuario_id": 1, "itens": [ { "produto_id": "1 OR 1=1", "quantidade": 1 } ] },
      "kind": "security", "finding": "AP-02", "expect": "rejected" },
    { "id": "neg-quantidade-pedido", "method": "POST", "path": "/pedidos",
      "body": { "usuario_id": 1, "itens": [ { "produto_id": 2, "quantidade": -1 } ] },
      "kind": "security", "finding": "AP-11", "expect": "rejected" },
    { "id": "nonexistent-pedido-status", "method": "PUT", "path": "/pedidos/9999999/status",
      "body": { "status": "aprovado" },
      "kind": "security", "finding": "AP-11", "expect": "rejected" },
    { "id": "create-pedido-invalid-usuario", "method": "POST", "path": "/pedidos",
      "body": { "usuario_id": 999999, "itens": [ { "produto_id": 1, "quantidade": 1 } ] },
      "kind": "security", "finding": "AP-20", "expect": "rejected" },

    { "id": "delete-produto", "method": "DELETE", "path": "/produtos/10", "destructive": true },
    { "id": "admin-reset-db", "method": "POST", "path": "/admin/reset-db", "destructive": true }
  ]
}
