# Variables to export before starting the application.
# The application reads the process environment; it does NOT load this file.
# Secrets are left empty on purpose: an empty value means "not configured".
#
#   SECRET_KEY            Flask signing key. Unset: a random per-process key is used.
#   OPERATOR_TOKEN        Operator credential for GET /relatorios/vendas, sent as the
#                         X-Operator-Token header. Unset: the route answers 403.
#   SEED_ADMIN_PASSWORD   Password of the seeded admin@loja.com account (first boot only).
#   SEED_JOAO_PASSWORD    Password of the seeded joao@email.com account (first boot only).
#   SEED_MARIA_PASSWORD   Password of the seeded maria@email.com account (first boot only).
#                         Unset: the seeded account is created with no usable password.
#   APP_DEBUG             "true" turns Flask debug mode on. Default: off.
#   APP_HOST              Bind address. Default: 0.0.0.0
#   APP_PORT              Port. Default: 5000
#   APP_ENV               Environment name reported by /health. Default: producao
#   DATABASE_FILE         SQLite file, relative to the project root. Default: loja.db
SECRET_KEY=
OPERATOR_TOKEN=
SEED_ADMIN_PASSWORD=
SEED_JOAO_PASSWORD=
SEED_MARIA_PASSWORD=
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
APP_ENV=producao
DATABASE_FILE=loja.db
