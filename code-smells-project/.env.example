# Every key the application reads (config/settings.py). Copy to .env or export in the environment.
# Unsafe values are opt-in; the defaults are the safe ones.

# Signing key. Unset: a random per-process key is generated.
SECRET_KEY=change-me

# Debug mode and the interactive debugger. Leave unset (off) outside development.
APP_DEBUG=false

# Bind address and port (defaults: 0.0.0.0 and 5000).
APP_HOST=0.0.0.0
PORT=5000

# SQLite database file (default: loja.db in the working directory).
DB_PATH=loja.db

# Value reported by GET /health.
APP_ENV=producao

# Credential for operator-only operations (GET /relatorios/vendas), sent in X-Operator-Token.
# Unset: those operations answer 403.
OPERATOR_TOKEN=
