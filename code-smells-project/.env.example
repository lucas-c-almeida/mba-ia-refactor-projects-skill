# Copie para .env (ou exporte no ambiente). Valores abaixo são placeholders.

# Chave de assinatura do Flask. Sem ela, uma chave efêmera é gerada a cada boot.
SECRET_KEY=<gere-um-valor-aleatorio-longo>

# Modo debug (habilita o debugger interativo do Werkzeug). Nunca em produção.
APP_DEBUG=false

APP_HOST=0.0.0.0
APP_PORT=5000

DATABASE_PATH=loja.db
APP_ENV=producao

# Origens permitidas para CORS, separadas por vírgula. "*" mantém a política atual.
CORS_ORIGINS=*
