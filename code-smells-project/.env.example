# Every key the application reads. Copy to the environment (the app does not load .env files itself).
# Signing key. When unset, a random per-process key is generated.
SECRET_KEY=change-me
# Debug mode is OFF unless this is true. Never enable it on a reachable host.
APP_DEBUG=false
# Bind address and port.
HOST=0.0.0.0
PORT=5000
# SQLite file.
DB_PATH=loja.db
# Value reported by /health as "ambiente".
APP_ENV=producao
# Operator credential for /relatorios/vendas (header x-operator-token). Unset = the route answers 403.
OPERATOR_TOKEN=
