# Copy to .env (never committed) or export in the environment. All keys are optional.
# Signing key; when absent a random key is generated per process.
SECRET_KEY=change-me
# Debug mode (interactive debugger). Development only: never enable where the port is reachable.
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
DB_PATH=loja.db
APP_ENV=producao
