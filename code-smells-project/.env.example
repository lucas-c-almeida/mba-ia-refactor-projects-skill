# Every key the application reads. Copy to .env or export in the environment; never commit real values.

# Flask signing key. Unset: a random key is generated per process.
SECRET_KEY=change-me

# Debug mode (interactive debugger). Off unless explicitly "true". Never enable it on an exposed host.
APP_DEBUG=false

# Bind address and port of the development server.
APP_HOST=0.0.0.0
APP_PORT=5000

# SQLite file.
DB_PATH=loja.db

# Environment label echoed by /health.
APP_ENV=producao

# Credential for operator-only endpoints (GET /relatorios/vendas, header X-Operator-Token).
# Unset: those endpoints answer 403 to everyone.
OPERATOR_TOKEN=
