{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    { "id": "health", "method": "GET", "path": "/health" },
    { "id": "index", "method": "GET", "path": "/" },
    { "id": "list-tasks", "method": "GET", "path": "/tasks" },
    { "id": "get-task", "method": "GET", "path": "/tasks/1" },
    { "id": "get-task-missing", "method": "GET", "path": "/tasks/9999" },
    { "id": "create-task", "method": "POST", "path": "/tasks",
      "body": {"title": "Probe task", "description": "probe", "status": "pending",
               "priority": 3, "user_id": 1, "category_id": 1, "tags": ["probe", "smoke"]} },
    { "id": "update-task", "method": "PUT", "path": "/tasks/1",
      "body": {"title": "Updated title probe", "status": "in_progress"} },
    { "id": "search-tasks", "method": "GET", "path": "/tasks/search?q=bug" },
    { "id": "task-stats", "method": "GET", "path": "/tasks/stats" },
    { "id": "list-users", "method": "GET", "path": "/users" },
    { "id": "get-user", "method": "GET", "path": "/users/1" },
    { "id": "get-user-missing", "method": "GET", "path": "/users/9999" },
    { "id": "create-user", "method": "POST", "path": "/users",
      "body": {"name": "Probe User", "email": "probe-user@example.com",
               "password": "probe1234", "role": "user"} },
    { "id": "update-user", "method": "PUT", "path": "/users/2",
      "body": {"name": "Maria Santos Updated"} },
    { "id": "get-user-tasks", "method": "GET", "path": "/users/1/tasks" },
    { "id": "login-ok", "method": "POST", "path": "/login",
      "body": {"email": "joao@email.com", "password": "1234"} },
    { "id": "login-bad", "method": "POST", "path": "/login",
      "body": {"email": "joao@email.com", "password": "wrongpass"} },
    { "id": "reports-summary", "method": "GET", "path": "/reports/summary" },
    { "id": "reports-user", "method": "GET", "path": "/reports/user/1" },
    { "id": "list-categories", "method": "GET", "path": "/categories" },
    { "id": "create-category", "method": "POST", "path": "/categories",
      "body": {"name": "Probe Category", "description": "probe", "color": "#123456"} },
    { "id": "update-category", "method": "PUT", "path": "/categories/1",
      "body": {"description": "Updated description"} },

    { "id": "delete-task", "method": "DELETE", "path": "/tasks/10", "destructive": true },
    { "id": "delete-user", "method": "DELETE", "path": "/users/3", "destructive": true },

    { "id": "update-category-no-body", "method": "PUT", "path": "/categories/2",
      "rawBody": "null", "kind": "security", "finding": "AP-11", "expect": "rejected" },
    { "id": "search-tasks-bad-priority", "method": "GET", "path": "/tasks/search?priority=abc",
      "kind": "security", "finding": "AP-11", "expect": "rejected" },
    { "id": "delete-category-with-tasks", "method": "DELETE", "path": "/categories/4",
      "destructive": true, "kind": "security", "finding": "AP-20", "expect": "rejected" }
  ]
}
