{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-root", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "get-tasks", "method": "GET", "path": "/tasks"},
    {"id": "get-tasks-1", "method": "GET", "path": "/tasks/1"},
    {"id": "get-tasks-9999", "method": "GET", "path": "/tasks/9999"},
    {"id": "post-tasks", "method": "POST", "path": "/tasks",
     "body": {"title": "Baseline task", "description": "created by the probe", "status": "pending", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a", "b"]}},
    {"id": "post-tasks-invalid-status", "method": "POST", "path": "/tasks",
     "body": {"title": "Bad status", "status": "bogus"}},
    {"id": "post-tasks-no-title", "method": "POST", "path": "/tasks",
     "body": {"description": "no title"}},
    {"id": "post-tasks-unknown-user", "method": "POST", "path": "/tasks",
     "body": {"title": "Unknown user", "user_id": 9999}},
    {"id": "put-tasks-1", "method": "PUT", "path": "/tasks/1",
     "body": {"title": "Updated title", "status": "in_progress", "tags": "x,y"}},
    {"id": "put-tasks-9999", "method": "PUT", "path": "/tasks/9999",
     "body": {"title": "Nobody home"}},
    {"id": "get-tasks-search", "method": "GET", "path": "/tasks/search?q=a&status=pending"},
    {"id": "get-tasks-search-all", "method": "GET", "path": "/tasks/search"},
    {"id": "get-tasks-stats", "method": "GET", "path": "/tasks/stats"},
    {"id": "get-users", "method": "GET", "path": "/users"},
    {"id": "get-users-1", "method": "GET", "path": "/users/1"},
    {"id": "get-users-9999", "method": "GET", "path": "/users/9999"},
    {"id": "get-users-1-tasks", "method": "GET", "path": "/users/1/tasks"},
    {"id": "get-users-9999-tasks", "method": "GET", "path": "/users/9999/tasks"},
    {"id": "post-users", "method": "POST", "path": "/users",
     "body": {"name": "Probe User", "email": "probe@email.com", "password": "abcd", "role": "user"}},
    {"id": "post-users-duplicate-email", "method": "POST", "path": "/users",
     "body": {"name": "Dup", "email": "joao@email.com", "password": "abcd"}},
    {"id": "post-users-invalid-email", "method": "POST", "path": "/users",
     "body": {"name": "Bad", "email": "not-an-email", "password": "abcd"}},
    {"id": "put-users-2", "method": "PUT", "path": "/users/2",
     "body": {"name": "Maria S"}},
    {"id": "put-users-9999", "method": "PUT", "path": "/users/9999",
     "body": {"name": "Nobody"}},
    {"id": "post-login", "method": "POST", "path": "/login",
     "body": {"email": "joao@email.com", "password": "1234"}},
    {"id": "post-login-wrong-password", "method": "POST", "path": "/login",
     "body": {"email": "joao@email.com", "password": "wrong"}},
    {"id": "get-reports-user-1", "method": "GET", "path": "/reports/user/1"},
    {"id": "get-reports-user-9999", "method": "GET", "path": "/reports/user/9999"},
    {"id": "get-reports-summary-operator", "method": "GET", "path": "/reports/summary",
     "headers": {"X-Operator-Token": "replay-operator-token"}},
    {"id": "get-categories", "method": "GET", "path": "/categories"},
    {"id": "post-categories", "method": "POST", "path": "/categories",
     "body": {"name": "Probe category", "description": "d", "color": "#123456"}},
    {"id": "post-categories-no-name", "method": "POST", "path": "/categories",
     "body": {"description": "no name"}},
    {"id": "put-categories-1", "method": "PUT", "path": "/categories/1",
     "body": {"description": "updated"}},
    {"id": "put-categories-9999", "method": "PUT", "path": "/categories/9999",
     "body": {"name": "Nobody"}},
    {"id": "get-tasks-origin", "method": "GET", "path": "/tasks",
     "headers": {"Origin": "http://example.test"}},
    {"id": "options-tasks-preflight", "method": "OPTIONS", "path": "/tasks",
     "headers": {"Origin": "http://example.test", "Access-Control-Request-Method": "POST"}},
    {"id": "delete-tasks-10", "method": "DELETE", "path": "/tasks/10", "destructive": true},
    {"id": "delete-users-3-operator", "method": "DELETE", "path": "/users/3", "destructive": true,
     "headers": {"X-Operator-Token": "replay-operator-token"}},
    {"id": "delete-categories-4", "method": "DELETE", "path": "/categories/4", "destructive": true},
    {"id": "get-reports-summary-anonymous", "method": "GET", "path": "/reports/summary",
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "delete-users-3-anonymous", "method": "DELETE", "path": "/users/3", "destructive": true,
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "post-tasks-priority-text", "method": "POST", "path": "/tasks",
     "body": {"title": "Text priority", "priority": "high"},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "get-tasks-search-priority-text", "method": "GET", "path": "/tasks/search?priority=abc",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "put-categories-1-null-body", "method": "PUT", "path": "/categories/1",
     "rawBody": "null",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "post-users-email-number", "method": "POST", "path": "/users",
     "body": {"name": "Numeric email", "email": 123, "password": "abcd"},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "post-tasks-description-list", "method": "POST", "path": "/tasks",
     "body": {"title": "List description", "description": ["x"]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "put-users-2-active-text", "method": "PUT", "path": "/users/2",
     "body": {"active": "maybe"},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "post-categories-name-list", "method": "POST", "path": "/categories",
     "body": {"name": ["x"]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"}
  ]
}
