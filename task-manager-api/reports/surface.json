{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    { "id": "get-root", "method": "GET", "path": "/" },
    { "id": "get-health", "method": "GET", "path": "/health" },
    { "id": "list-tasks", "method": "GET", "path": "/tasks" },
    { "id": "val-list-tasks", "method": "GET", "path": "/tasks", "kind": "value",
      "assert": [
        { "path": "$[*].id", "sameAsBaseline": true },
        { "path": "$[*].user_name", "sameAsBaseline": true },
        { "path": "$[*].category_name", "sameAsBaseline": true },
        { "path": "$[*].overdue", "sameAsBaseline": true },
        { "path": "$[*].tags", "sameAsBaseline": true }
      ] },
    { "id": "get-task", "method": "GET", "path": "/tasks/1" },
    { "id": "val-task-timestamp-format", "method": "GET", "path": "/tasks/1", "kind": "value",
      "assert": [
        { "path": "$.created_at", "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}$" },
        { "path": "$.overdue", "sameAsBaseline": true }
      ] },
    { "id": "get-task-missing", "method": "GET", "path": "/tasks/9999" },
    { "id": "search-tasks", "method": "GET", "path": "/tasks/search?q=API&status=pending&priority=3&user_id=1" },
    { "id": "val-search-tasks", "method": "GET", "path": "/tasks/search?q=a&status=pending", "kind": "value",
      "assert": [ { "path": "$[*].id", "sameAsBaseline": true } ] },
    { "id": "search-tasks-no-match", "method": "GET", "path": "/tasks/search?q=zzzz-nothing" },
    { "id": "task-stats", "method": "GET", "path": "/tasks/stats" },
    { "id": "val-task-stats", "method": "GET", "path": "/tasks/stats", "kind": "value",
      "assert": [
        { "path": "$.total", "sameAsBaseline": true },
        { "path": "$.pending", "sameAsBaseline": true },
        { "path": "$.in_progress", "sameAsBaseline": true },
        { "path": "$.done", "sameAsBaseline": true },
        { "path": "$.cancelled", "sameAsBaseline": true },
        { "path": "$.overdue", "sameAsBaseline": true },
        { "path": "$.completion_rate", "sameAsBaseline": true }
      ] },
    { "id": "create-task", "method": "POST", "path": "/tasks",
      "body": { "title": "Nova task de teste", "description": "criada pelo probe", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a", "b"] } },
    { "id": "create-task-missing-title", "method": "POST", "path": "/tasks", "body": { "description": "sem titulo" } },
    { "id": "create-task-short-title", "method": "POST", "path": "/tasks", "body": { "title": "ab" } },
    { "id": "create-task-bad-status", "method": "POST", "path": "/tasks", "body": { "title": "Status ruim", "status": "archived" } },
    { "id": "create-task-bad-priority", "method": "POST", "path": "/tasks", "body": { "title": "Prioridade ruim", "priority": 9 } },
    { "id": "create-task-unknown-user", "method": "POST", "path": "/tasks", "body": { "title": "Usuario inexistente", "user_id": 9999 } },
    { "id": "create-task-unknown-category", "method": "POST", "path": "/tasks", "body": { "title": "Categoria inexistente", "category_id": 9999 } },
    { "id": "create-task-bad-date", "method": "POST", "path": "/tasks", "body": { "title": "Data ruim", "due_date": "31/12/2030" } },
    { "id": "update-task", "method": "PUT", "path": "/tasks/2", "body": { "status": "done", "due_date": "2030-02-02", "tags": ["x", "y"] } },
    { "id": "update-task-clear-due-date", "method": "PUT", "path": "/tasks/5", "body": { "due_date": null, "user_id": null } },
    { "id": "update-task-missing", "method": "PUT", "path": "/tasks/9999", "body": { "title": "abc" } },
    { "id": "update-task-bad-status", "method": "PUT", "path": "/tasks/2", "body": { "status": "archived" } },
    { "id": "delete-task-missing", "method": "DELETE", "path": "/tasks/9999" },
    { "id": "list-users", "method": "GET", "path": "/users" },
    { "id": "val-list-users", "method": "GET", "path": "/users", "kind": "value",
      "assert": [ { "path": "$[*].task_count", "sameAsBaseline": true }, { "path": "$[*].id", "sameAsBaseline": true } ] },
    { "id": "get-user", "method": "GET", "path": "/users/1" },
    { "id": "val-get-user-password-masked", "method": "GET", "path": "/users/1", "kind": "value",
      "assert": [ { "path": "$.password", "matches": "^\\*+$" }, { "path": "$.tasks[*].id", "sameAsBaseline": true } ] },
    { "id": "get-user-missing", "method": "GET", "path": "/users/9999" },
    { "id": "user-tasks", "method": "GET", "path": "/users/1/tasks" },
    { "id": "user-tasks-missing", "method": "GET", "path": "/users/9999/tasks" },
    { "id": "create-user", "method": "POST", "path": "/users",
      "body": { "name": "Ana Teste", "email": "ana.teste@email.com", "password": "{{env:TEST_USER_PASSWORD}}" } },
    { "id": "create-user-duplicate", "method": "POST", "path": "/users",
      "body": { "name": "Ana Dup", "email": "ana.teste@email.com", "password": "{{env:TEST_USER_PASSWORD}}" } },
    { "id": "create-user-bad-email", "method": "POST", "path": "/users",
      "body": { "name": "Email Ruim", "email": "nao-e-email", "password": "{{env:TEST_USER_PASSWORD}}" } },
    { "id": "create-user-short-password", "method": "POST", "path": "/users",
      "body": { "name": "Senha Curta", "email": "curta@email.com", "password": "{{env:SHORT_PASSWORD}}" } },
    { "id": "create-user-bad-role", "method": "POST", "path": "/users",
      "body": { "name": "Role Ruim", "email": "role@email.com", "password": "{{env:TEST_USER_PASSWORD}}", "role": "root" } },
    { "id": "update-user-name", "method": "PUT", "path": "/users/2", "body": { "name": "Maria S." } },
    { "id": "update-user-resend-stored", "method": "PUT", "path": "/users/2", "body": { "email": "maria@email.com", "role": "user", "active": true } },
    { "id": "update-user-missing", "method": "PUT", "path": "/users/9999", "body": { "name": "Ninguem" } },
    { "id": "update-user-role-operator", "method": "PUT", "path": "/users/3",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" }, "body": { "role": "admin" } },
    { "id": "login", "method": "POST", "path": "/login", "body": { "email": "ana.teste@email.com", "password": "{{env:TEST_USER_PASSWORD}}" } },
    { "id": "val-login-password-masked", "method": "POST", "path": "/login", "kind": "value",
      "body": { "email": "ana.teste@email.com", "password": "{{env:TEST_USER_PASSWORD}}" },
      "assert": [ { "path": "$.user.password", "matches": "^\\*+$" } ] },
    { "id": "login-wrong-password", "method": "POST", "path": "/login", "body": { "email": "ana.teste@email.com", "password": "{{env:WRONG_PASSWORD}}" } },
    { "id": "login-unknown-email", "method": "POST", "path": "/login", "body": { "email": "ninguem@email.com", "password": "{{env:WRONG_PASSWORD}}" } },
    { "id": "login-missing-fields", "method": "POST", "path": "/login", "body": { "email": "ana.teste@email.com" } },
    { "id": "summary-report-operator", "method": "GET", "path": "/reports/summary",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" } },
    { "id": "val-summary-report", "method": "GET", "path": "/reports/summary", "kind": "value",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "assert": [
        { "path": "$.overview.total_tasks", "sameAsBaseline": true },
        { "path": "$.overview.total_users", "sameAsBaseline": true },
        { "path": "$.overview.total_categories", "sameAsBaseline": true },
        { "path": "$.tasks_by_status.pending", "sameAsBaseline": true },
        { "path": "$.tasks_by_status.in_progress", "sameAsBaseline": true },
        { "path": "$.tasks_by_status.done", "sameAsBaseline": true },
        { "path": "$.tasks_by_status.cancelled", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority.critical", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority.high", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority.medium", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority.low", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority.minimal", "sameAsBaseline": true },
        { "path": "$.overdue.count", "sameAsBaseline": true },
        { "path": "$.overdue.tasks[*].id", "sameAsBaseline": true },
        { "path": "$.overdue.tasks[*].days_overdue", "sameAsBaseline": true },
        { "path": "$.recent_activity.tasks_created_last_7_days", "sameAsBaseline": true },
        { "path": "$.recent_activity.tasks_completed_last_7_days", "sameAsBaseline": true },
        { "path": "$.user_productivity[*].user_id", "sameAsBaseline": true },
        { "path": "$.user_productivity[*].total_tasks", "sameAsBaseline": true },
        { "path": "$.user_productivity[*].completed_tasks", "sameAsBaseline": true },
        { "path": "$.user_productivity[*].completion_rate", "sameAsBaseline": true }
      ] },
    { "id": "user-report", "method": "GET", "path": "/reports/user/1" },
    { "id": "val-user-report", "method": "GET", "path": "/reports/user/1", "kind": "value",
      "assert": [
        { "path": "$.statistics.total_tasks", "sameAsBaseline": true },
        { "path": "$.statistics.done", "sameAsBaseline": true },
        { "path": "$.statistics.pending", "sameAsBaseline": true },
        { "path": "$.statistics.overdue", "sameAsBaseline": true },
        { "path": "$.statistics.high_priority", "sameAsBaseline": true },
        { "path": "$.statistics.completion_rate", "sameAsBaseline": true }
      ] },
    { "id": "user-report-missing", "method": "GET", "path": "/reports/user/9999" },
    { "id": "list-categories", "method": "GET", "path": "/categories" },
    { "id": "val-list-categories", "method": "GET", "path": "/categories", "kind": "value",
      "assert": [ { "path": "$[*].id", "sameAsBaseline": true }, { "path": "$[*].task_count", "sameAsBaseline": true } ] },
    { "id": "create-category", "method": "POST", "path": "/categories", "body": { "name": "QA", "color": "#123456" } },
    { "id": "create-category-missing-name", "method": "POST", "path": "/categories", "body": { "color": "#123456" } },
    { "id": "update-category", "method": "PUT", "path": "/categories/1", "body": { "description": "Backend tasks" } },
    { "id": "update-category-missing", "method": "PUT", "path": "/categories/9999", "body": { "name": "x" } },
    { "id": "delete-category-missing", "method": "DELETE", "path": "/categories/9999" },
    { "id": "cors-simple-get", "method": "GET", "path": "/tasks/stats", "headers": { "Origin": "https://client.example" } },
    { "id": "cors-preflight-post", "method": "OPTIONS", "path": "/tasks",
      "headers": { "Origin": "https://client.example", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type" } },
    { "id": "cors-preflight-put-user", "method": "OPTIONS", "path": "/users/1",
      "headers": { "Origin": "https://client.example", "Access-Control-Request-Method": "PUT", "Access-Control-Request-Headers": "content-type, x-operator-token" } },

    { "id": "delete-task", "method": "DELETE", "path": "/tasks/3", "destructive": true },
    { "id": "delete-category", "method": "DELETE", "path": "/categories/4", "destructive": true },
    { "id": "delete-user-operator", "method": "DELETE", "path": "/users/3", "destructive": true,
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" } },

    { "id": "sec-delete-user-anonymous", "method": "DELETE", "path": "/users/2", "destructive": true,
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "sec-summary-report-anonymous", "method": "GET", "path": "/reports/summary",
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "sec-update-user-password-anonymous", "method": "PUT", "path": "/users/1",
      "body": { "password": "{{env:NEW_PASSWORD}}" }, "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "sec-update-user-email-anonymous", "method": "PUT", "path": "/users/1",
      "body": { "email": "hijack@email.com" }, "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "sec-update-user-role-anonymous", "method": "PUT", "path": "/users/1",
      "body": { "role": "user" }, "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "sec-update-user-active-anonymous", "method": "PUT", "path": "/users/1",
      "body": { "active": false }, "kind": "security", "finding": "AP-04", "expect": "rejected" },

    { "id": "rob-get-task", "method": "GET", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "task_id", "type": "integer", "value": 1 } ] },
    { "id": "rob-search-tasks", "method": "GET", "path": "/tasks/search?q=API&status=pending&priority=3&user_id=1", "kind": "robustness", "finding": "AP-11",
      "fields": [
        { "in": "query", "name": "q", "type": "string" },
        { "in": "query", "name": "status", "type": "string" },
        { "in": "query", "name": "priority", "type": "integer" },
        { "in": "query", "name": "user_id", "type": "integer" }
      ] },
    { "id": "rob-create-task", "method": "POST", "path": "/tasks", "kind": "robustness", "finding": "AP-11",
      "body": { "title": "Robust task", "description": "d", "status": "pending", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a"] },
      "fields": [
        { "in": "body", "name": "title", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "status", "type": "string" },
        { "in": "body", "name": "priority", "type": "integer" },
        { "in": "body", "name": "user_id", "type": "integer" },
        { "in": "body", "name": "category_id", "type": "integer" },
        { "in": "body", "name": "due_date", "type": "string" },
        { "in": "body", "name": "tags", "type": "array" }
      ] },
    { "id": "rob-update-task", "method": "PUT", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "title": "Robust update", "description": "d", "status": "in_progress", "priority": 3, "user_id": 1, "category_id": 1, "due_date": "2030-03-03", "tags": ["r"] },
      "fields": [
        { "in": "path", "name": "task_id", "type": "integer", "value": 1 },
        { "in": "body", "name": "title", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "status", "type": "string" },
        { "in": "body", "name": "priority", "type": "integer" },
        { "in": "body", "name": "user_id", "type": "integer" },
        { "in": "body", "name": "category_id", "type": "integer" },
        { "in": "body", "name": "due_date", "type": "string" },
        { "in": "body", "name": "tags", "type": "array" }
      ] },
    { "id": "rob-delete-task", "method": "DELETE", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "task_id", "type": "integer", "value": 1 } ] },
    { "id": "rob-get-user", "method": "GET", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rob-user-tasks", "method": "GET", "path": "/users/{user_id}/tasks", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rob-create-user", "method": "POST", "path": "/users", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Robust User", "email": "robust@email.com", "password": "{{env:TEST_USER_PASSWORD}}", "role": "user" },
      "fields": [
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" },
        { "in": "body", "name": "role", "type": "string" }
      ] },
    { "id": "rob-update-user", "method": "PUT", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Pedro Oliveira" },
      "fields": [
        { "in": "path", "name": "user_id", "type": "integer", "value": 3 },
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" },
        { "in": "body", "name": "role", "type": "string" },
        { "in": "body", "name": "active", "type": "boolean" },
        { "in": "header", "name": "X-Operator-Token", "type": "string" }
      ] },
    { "id": "rob-delete-user", "method": "DELETE", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [
        { "in": "path", "name": "user_id", "type": "integer", "value": 9999 },
        { "in": "header", "name": "X-Operator-Token", "type": "string" }
      ] },
    { "id": "rob-login", "method": "POST", "path": "/login", "kind": "robustness", "finding": "AP-11",
      "body": { "email": "ana.teste@email.com", "password": "{{env:TEST_USER_PASSWORD}}" },
      "fields": [
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" }
      ] },
    { "id": "rob-summary-report", "method": "GET", "path": "/reports/summary", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "header", "name": "X-Operator-Token", "type": "string" } ] },
    { "id": "rob-user-report", "method": "GET", "path": "/reports/user/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rob-create-category", "method": "POST", "path": "/categories", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Robust Cat", "description": "d", "color": "#abcdef" },
      "fields": [
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "color", "type": "string" }
      ] },
    { "id": "rob-update-category", "method": "PUT", "path": "/categories/{cat_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Backend", "description": "d", "color": "#3498db" },
      "fields": [
        { "in": "path", "name": "cat_id", "type": "integer", "value": 2 },
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "color", "type": "string" }
      ] },
    { "id": "rob-delete-category", "method": "DELETE", "path": "/categories/{cat_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "cat_id", "type": "integer", "value": 2 } ] }
  ]
}
