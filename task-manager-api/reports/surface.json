{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    { "id": "get-index", "method": "GET", "path": "/" },
    { "id": "get-health", "method": "GET", "path": "/health" },
    { "id": "list-tasks", "method": "GET", "path": "/tasks" },
    { "id": "list-tasks-values", "method": "GET", "path": "/tasks", "kind": "value",
      "assert": [
        { "path": "$[*].id", "sameAsBaseline": true },
        { "path": "$[*].overdue", "sameAsBaseline": true },
        { "path": "$[*].user_name", "sameAsBaseline": true },
        { "path": "$[*].category_name", "sameAsBaseline": true },
        { "path": "$[*].tags", "sameAsBaseline": true },
        { "path": "$[*].created_at", "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$" }
      ] },
    { "id": "get-task", "method": "GET", "path": "/tasks/1" },
    { "id": "get-task-values", "method": "GET", "path": "/tasks/1", "kind": "value",
      "assert": [
        { "path": "$.overdue", "sameAsBaseline": true },
        { "path": "$.due_date", "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$" }
      ] },
    { "id": "get-task-missing", "method": "GET", "path": "/tasks/9999" },
    { "id": "search-tasks", "method": "GET", "path": "/tasks/search?q=API&status=pending&priority=3&user_id=1" },
    { "id": "search-tasks-values", "method": "GET", "path": "/tasks/search?q=API&status=pending&priority=3&user_id=1", "kind": "value",
      "assert": [ { "path": "$[*].id", "sameAsBaseline": true } ] },
    { "id": "search-tasks-all", "method": "GET", "path": "/tasks/search" },
    { "id": "task-stats", "method": "GET", "path": "/tasks/stats" },
    { "id": "task-stats-values", "method": "GET", "path": "/tasks/stats", "kind": "value",
      "assert": [
        { "path": "$.total", "sameAsBaseline": true },
        { "path": "$.pending", "sameAsBaseline": true },
        { "path": "$.done", "sameAsBaseline": true },
        { "path": "$.overdue", "sameAsBaseline": true },
        { "path": "$.completion_rate", "sameAsBaseline": true }
      ] },
    { "id": "create-task", "method": "POST", "path": "/tasks",
      "body": { "title": "Nova task", "description": "criada pelo probe", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a", "b"] } },
    { "id": "create-task-missing-title", "method": "POST", "path": "/tasks", "body": { "description": "sem titulo" } },
    { "id": "create-task-short-title", "method": "POST", "path": "/tasks", "body": { "title": "ab" } },
    { "id": "create-task-bad-status", "method": "POST", "path": "/tasks", "body": { "title": "Status ruim", "status": "archived" } },
    { "id": "create-task-bad-priority", "method": "POST", "path": "/tasks", "body": { "title": "Prioridade ruim", "priority": 9 } },
    { "id": "create-task-unknown-user", "method": "POST", "path": "/tasks", "body": { "title": "Usuario ruim", "user_id": 9999 } },
    { "id": "create-task-unknown-category", "method": "POST", "path": "/tasks", "body": { "title": "Categoria ruim", "category_id": 9999 } },
    { "id": "create-task-bad-date", "method": "POST", "path": "/tasks", "body": { "title": "Data ruim", "due_date": "31/12/2030" } },
    { "id": "create-task-empty-body", "method": "POST", "path": "/tasks", "body": {} },
    { "id": "update-task", "method": "PUT", "path": "/tasks/2",
      "body": { "title": "Atualizada", "status": "done", "priority": 4, "due_date": "2030-02-02", "tags": ["x", "y"], "user_id": 2, "category_id": 2 } },
    { "id": "update-task-clear-date", "method": "PUT", "path": "/tasks/5", "body": { "due_date": null, "tags": "solo" } },
    { "id": "update-task-missing", "method": "PUT", "path": "/tasks/9999", "body": { "title": "Inexistente" } },
    { "id": "update-task-short-title", "method": "PUT", "path": "/tasks/2", "body": { "title": "ab" } },
    { "id": "update-task-bad-status", "method": "PUT", "path": "/tasks/2", "body": { "status": "archived" } },
    { "id": "update-task-unknown-user", "method": "PUT", "path": "/tasks/2", "body": { "user_id": 9999 } },
    { "id": "update-task-bad-date", "method": "PUT", "path": "/tasks/2", "body": { "due_date": "02/02/2030" } },
    { "id": "update-task-empty-body", "method": "PUT", "path": "/tasks/2", "body": {} },
    { "id": "delete-task-missing", "method": "DELETE", "path": "/tasks/9999" },
    { "id": "list-users", "method": "GET", "path": "/users" },
    { "id": "list-users-values", "method": "GET", "path": "/users", "kind": "value",
      "assert": [
        { "path": "$[*].id", "sameAsBaseline": true },
        { "path": "$[*].task_count", "sameAsBaseline": true },
        { "path": "$[*].password", "absent": true }
      ] },
    { "id": "get-user", "method": "GET", "path": "/users/1" },
    { "id": "get-user-values", "method": "GET", "path": "/users/1", "kind": "value",
      "assert": [
        { "path": "$.password", "matches": "^\\*+$" },
        { "path": "$.tasks[*].id", "sameAsBaseline": true }
      ] },
    { "id": "get-user-missing", "method": "GET", "path": "/users/9999" },
    { "id": "create-user", "method": "POST", "path": "/users",
      "body": { "name": "Ana Costa", "email": "ana@email.com", "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "create-user-values", "method": "POST", "path": "/users", "kind": "value",
      "body": { "name": "Bia Lima", "email": "bia@email.com", "password": "{{env:NEW_USER_PASSWORD}}", "role": "manager" },
      "assert": [
        { "path": "$.password", "matches": "^\\*+$" },
        { "path": "$.role", "equals": "manager" }
      ] },
    { "id": "create-user-duplicate", "method": "POST", "path": "/users",
      "body": { "name": "Joao Dois", "email": "joao@email.com", "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "create-user-bad-email", "method": "POST", "path": "/users",
      "body": { "name": "Sem Email", "email": "invalido", "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "create-user-short-password", "method": "POST", "path": "/users",
      "body": { "name": "Senha Curta", "email": "curta@email.com", "password": "{{env:SHORT_PASSWORD}}" } },
    { "id": "create-user-bad-role", "method": "POST", "path": "/users",
      "body": { "name": "Papel Ruim", "email": "papel@email.com", "password": "{{env:NEW_USER_PASSWORD}}", "role": "root" } },
    { "id": "create-user-missing-name", "method": "POST", "path": "/users",
      "body": { "email": "nome@email.com", "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "update-user", "method": "PUT", "path": "/users/2", "body": { "name": "Maria S.", "email": "maria.s@email.com" } },
    { "id": "update-user-same-role-active", "method": "PUT", "path": "/users/2",
      "body": { "name": "Maria Santos", "email": "maria.s@email.com", "role": "user", "active": true } },
    { "id": "update-user-same-role-active-values", "method": "PUT", "path": "/users/2", "kind": "value",
      "body": { "role": "user", "active": true },
      "assert": [
        { "path": "$.role", "equals": "user" },
        { "path": "$.active", "equals": true },
        { "path": "$.password", "matches": "^\\*+$" }
      ] },
    { "id": "update-user-password", "method": "PUT", "path": "/users/2", "body": { "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "update-user-duplicate-email", "method": "PUT", "path": "/users/2", "body": { "email": "joao@email.com" } },
    { "id": "update-user-bad-email", "method": "PUT", "path": "/users/2", "body": { "email": "invalido" } },
    { "id": "update-user-short-password", "method": "PUT", "path": "/users/2", "body": { "password": "{{env:SHORT_PASSWORD}}" } },
    { "id": "update-user-bad-role", "method": "PUT", "path": "/users/2", "body": { "role": "root" } },
    { "id": "update-user-missing", "method": "PUT", "path": "/users/9999", "body": { "name": "Ninguem" } },
    { "id": "update-user-role-operator", "method": "PUT", "path": "/users/3",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" }, "body": { "role": "admin" } },
    { "id": "user-tasks", "method": "GET", "path": "/users/1/tasks" },
    { "id": "user-tasks-values", "method": "GET", "path": "/users/1/tasks", "kind": "value",
      "assert": [
        { "path": "$[*].id", "sameAsBaseline": true },
        { "path": "$[*].overdue", "sameAsBaseline": true }
      ] },
    { "id": "user-tasks-missing", "method": "GET", "path": "/users/9999/tasks" },
    { "id": "login", "method": "POST", "path": "/login",
      "body": { "email": "joao@email.com", "password": "{{env:SEED_ADMIN_PASSWORD}}" } },
    { "id": "login-values", "method": "POST", "path": "/login", "kind": "value",
      "body": { "email": "joao@email.com", "password": "{{env:SEED_ADMIN_PASSWORD}}" },
      "assert": [
        { "path": "$.user.password", "matches": "^\\*+$" },
        { "path": "$.user.id", "equals": 1 }
      ] },
    { "id": "login-after-password-change", "method": "POST", "path": "/login",
      "body": { "email": "maria.s@email.com", "password": "{{env:NEW_USER_PASSWORD}}" } },
    { "id": "login-wrong-password", "method": "POST", "path": "/login",
      "body": { "email": "joao@email.com", "password": "{{env:WRONG_PASSWORD}}" } },
    { "id": "login-unknown-email", "method": "POST", "path": "/login",
      "body": { "email": "ninguem@email.com", "password": "{{env:WRONG_PASSWORD}}" } },
    { "id": "login-missing-password", "method": "POST", "path": "/login", "body": { "email": "joao@email.com" } },
    { "id": "report-summary-operator", "method": "GET", "path": "/reports/summary",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" } },
    { "id": "report-summary-operator-values", "method": "GET", "path": "/reports/summary", "kind": "value",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "assert": [
        { "path": "$.overview", "sameAsBaseline": true },
        { "path": "$.tasks_by_status", "sameAsBaseline": true },
        { "path": "$.tasks_by_priority", "sameAsBaseline": true },
        { "path": "$.overdue.count", "sameAsBaseline": true },
        { "path": "$.overdue.tasks[*].id", "sameAsBaseline": true },
        { "path": "$.overdue.tasks[*].days_overdue", "sameAsBaseline": true },
        { "path": "$.recent_activity", "sameAsBaseline": true },
        { "path": "$.user_productivity", "sameAsBaseline": true }
      ] },
    { "id": "report-user", "method": "GET", "path": "/reports/user/1" },
    { "id": "report-user-values", "method": "GET", "path": "/reports/user/1", "kind": "value",
      "assert": [ { "path": "$.statistics", "sameAsBaseline": true } ] },
    { "id": "report-user-missing", "method": "GET", "path": "/reports/user/9999" },
    { "id": "list-categories", "method": "GET", "path": "/categories" },
    { "id": "list-categories-values", "method": "GET", "path": "/categories", "kind": "value",
      "assert": [
        { "path": "$[*].id", "sameAsBaseline": true },
        { "path": "$[*].task_count", "sameAsBaseline": true }
      ] },
    { "id": "create-category", "method": "POST", "path": "/categories", "body": { "name": "QA", "description": "Qualidade", "color": "#123456" } },
    { "id": "create-category-defaults", "method": "POST", "path": "/categories", "body": { "name": "Docs" } },
    { "id": "create-category-missing-name", "method": "POST", "path": "/categories", "body": { "color": "#123456" } },
    { "id": "create-category-empty-body", "method": "POST", "path": "/categories", "body": {} },
    { "id": "update-category", "method": "PUT", "path": "/categories/1", "body": { "color": "#111111", "description": "Backend e APIs" } },
    { "id": "update-category-empty-body", "method": "PUT", "path": "/categories/1", "body": {} },
    { "id": "update-category-missing", "method": "PUT", "path": "/categories/9999", "body": { "name": "Nada" } },
    { "id": "delete-category-missing", "method": "DELETE", "path": "/categories/9999" },
    { "id": "unknown-route", "method": "GET", "path": "/nao-existe" },
    { "id": "cors-simple", "method": "GET", "path": "/tasks/stats", "headers": { "Origin": "https://example.org" } },
    { "id": "cors-preflight", "method": "OPTIONS", "path": "/tasks",
      "headers": { "Origin": "https://example.org", "Access-Control-Request-Method": "DELETE", "Access-Control-Request-Headers": "content-type" } },

    { "id": "delete-task", "method": "DELETE", "path": "/tasks/3", "destructive": true },
    { "id": "delete-category", "method": "DELETE", "path": "/categories/4", "destructive": true },
    { "id": "delete-user-operator", "method": "DELETE", "path": "/users/3", "destructive": true,
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" } },

    { "id": "report-summary-anonymous", "method": "GET", "path": "/reports/summary",
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "update-user-role-anonymous", "method": "PUT", "path": "/users/2", "body": { "role": "admin" },
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "update-user-deactivate-anonymous", "method": "PUT", "path": "/users/1", "body": { "active": false },
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "delete-user-anonymous", "method": "DELETE", "path": "/users/2", "destructive": true,
      "kind": "security", "finding": "AP-04", "expect": "rejected" },
    { "id": "create-task-dangling-user", "method": "POST", "path": "/tasks", "body": { "title": "Referencia vazia", "user_id": 0, "category_id": 0 },
      "kind": "security", "finding": "AP-20", "expect": "rejected" },

    { "id": "rb-get-task", "method": "GET", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "task_id", "type": "integer", "value": 1 } ] },
    { "id": "rb-search-tasks", "method": "GET", "path": "/tasks/search?q=API&status=pending&priority=3&user_id=1", "kind": "robustness", "finding": "AP-11",
      "fields": [
        { "in": "query", "name": "q", "type": "string" },
        { "in": "query", "name": "status", "type": "string" },
        { "in": "query", "name": "priority", "type": "integer" },
        { "in": "query", "name": "user_id", "type": "integer" }
      ] },
    { "id": "rb-create-task", "method": "POST", "path": "/tasks", "kind": "robustness", "finding": "AP-11",
      "body": { "title": "Robusta", "description": "d", "status": "pending", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a"] },
      "fields": [
        { "in": "body", "name": "title", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "status", "type": "string" },
        { "in": "body", "name": "priority", "type": "integer" },
        { "in": "body", "name": "user_id", "type": "integer" },
        { "in": "body", "name": "category_id", "type": "integer" },
        { "in": "body", "name": "due_date", "type": "string" },
        { "in": "body", "name": "tags", "type": "array" }
      ] },
    { "id": "rb-update-task", "method": "PUT", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "title": "Robusta", "description": "d", "status": "pending", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a"] },
      "fields": [
        { "in": "path", "name": "task_id", "type": "integer", "value": 1 },
        { "in": "body", "name": "title", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "status", "type": "string" },
        { "in": "body", "name": "priority", "type": "integer" },
        { "in": "body", "name": "user_id", "type": "integer" },
        { "in": "body", "name": "category_id", "type": "integer" },
        { "in": "body", "name": "due_date", "type": "string" },
        { "in": "body", "name": "tags", "type": "array" }
      ] },
    { "id": "rb-delete-task", "method": "DELETE", "path": "/tasks/{task_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "task_id", "type": "integer", "value": 9999 } ] },
    { "id": "rb-get-user", "method": "GET", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rb-user-tasks", "method": "GET", "path": "/users/{user_id}/tasks", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rb-create-user", "method": "POST", "path": "/users", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Robusto", "email": "robusto@email.com", "password": "{{env:NEW_USER_PASSWORD}}", "role": "user" },
      "fields": [
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" },
        { "in": "body", "name": "role", "type": "string" }
      ] },
    { "id": "rb-update-user", "method": "PUT", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Pedro Oliveira", "email": "pedro@email.com", "password": "{{env:NEW_USER_PASSWORD}}", "role": "admin", "active": true },
      "fields": [
        { "in": "path", "name": "user_id", "type": "integer", "value": 3 },
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" },
        { "in": "body", "name": "role", "type": "string" },
        { "in": "body", "name": "active", "type": "boolean" }
      ] },
    { "id": "rb-delete-user", "method": "DELETE", "path": "/users/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 9999 } ] },
    { "id": "rb-login", "method": "POST", "path": "/login", "kind": "robustness", "finding": "AP-11",
      "body": { "email": "pedro@email.com", "password": "{{env:WRONG_PASSWORD}}" },
      "fields": [
        { "in": "body", "name": "email", "type": "string" },
        { "in": "body", "name": "password", "type": "string" }
      ] },
    { "id": "rb-report-summary", "method": "GET", "path": "/reports/summary", "kind": "robustness", "finding": "AP-11",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "fields": [ { "in": "header", "name": "X-Operator-Token", "type": "string" } ] },
    { "id": "rb-report-user", "method": "GET", "path": "/reports/user/{user_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "user_id", "type": "integer", "value": 1 } ] },
    { "id": "rb-create-category", "method": "POST", "path": "/categories", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Robusta", "description": "d", "color": "#abcdef" },
      "fields": [
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "color", "type": "string" }
      ] },
    { "id": "rb-update-category", "method": "PUT", "path": "/categories/{cat_id}", "kind": "robustness", "finding": "AP-11",
      "body": { "name": "Backend", "description": "d", "color": "#abcdef" },
      "fields": [
        { "in": "path", "name": "cat_id", "type": "integer", "value": 2 },
        { "in": "body", "name": "name", "type": "string" },
        { "in": "body", "name": "description", "type": "string" },
        { "in": "body", "name": "color", "type": "string" }
      ] },
    { "id": "rb-delete-category", "method": "DELETE", "path": "/categories/{cat_id}", "kind": "robustness", "finding": "AP-11",
      "fields": [ { "in": "path", "name": "cat_id", "type": "integer", "value": 9999 } ] }
  ]
}
