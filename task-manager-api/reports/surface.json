{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:5000",
  "entries": [
    {"id": "get-root", "method": "GET", "path": "/"},
    {"id": "get-health", "method": "GET", "path": "/health"},
    {"id": "get-tasks", "method": "GET", "path": "/tasks"},
    {"id": "get-tasks-1", "method": "GET", "path": "/tasks/1"},
    {"id": "get-tasks-missing", "method": "GET", "path": "/tasks/9999"},
    {"id": "get-tasks-search-text", "method": "GET", "path": "/tasks/search?q=a"},
    {"id": "get-tasks-search-filters", "method": "GET", "path": "/tasks/search?status=pending&priority=1&user_id=1"},
    {"id": "get-tasks-stats", "method": "GET", "path": "/tasks/stats"},
    {"id": "post-tasks-valid", "method": "POST", "path": "/tasks",
     "body": {"title": "Probe task", "description": "created by the probe", "status": "pending", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-01", "tags": ["a", "b"]}},
    {"id": "post-tasks-missing-title", "method": "POST", "path": "/tasks", "body": {"description": "no title"}},
    {"id": "post-tasks-short-title", "method": "POST", "path": "/tasks", "body": {"title": "ab"}},
    {"id": "post-tasks-invalid-status", "method": "POST", "path": "/tasks", "body": {"title": "abc", "status": "nope"}},
    {"id": "post-tasks-priority-out-of-range", "method": "POST", "path": "/tasks", "body": {"title": "abc", "priority": 9}},
    {"id": "post-tasks-unknown-user", "method": "POST", "path": "/tasks", "body": {"title": "abc", "user_id": 9999}},
    {"id": "post-tasks-bad-date", "method": "POST", "path": "/tasks", "body": {"title": "abc", "due_date": "31/12/2030"}},
    {"id": "put-tasks-1-valid", "method": "PUT", "path": "/tasks/1", "body": {"status": "in_progress", "priority": 2, "tags": ["x", "y"]}},
    {"id": "put-tasks-missing", "method": "PUT", "path": "/tasks/9999", "body": {"title": "abc"}},
    {"id": "put-tasks-2-invalid-status", "method": "PUT", "path": "/tasks/2", "body": {"status": "nope"}},
    {"id": "delete-tasks-missing", "method": "DELETE", "path": "/tasks/9999"},
    {"id": "get-users", "method": "GET", "path": "/users"},
    {"id": "get-users-1", "method": "GET", "path": "/users/1"},
    {"id": "get-users-missing", "method": "GET", "path": "/users/9999"},
    {"id": "post-users-valid", "method": "POST", "path": "/users",
     "body": {"name": "Probe User", "email": "probe@example.com", "password": "probe-pass", "role": "user"}},
    {"id": "post-users-duplicate-email", "method": "POST", "path": "/users",
     "body": {"name": "Dup", "email": "joao@email.com", "password": "abcd"}},
    {"id": "post-users-invalid-email", "method": "POST", "path": "/users",
     "body": {"name": "Bad", "email": "nope", "password": "abcd"}},
    {"id": "post-users-missing-name", "method": "POST", "path": "/users",
     "body": {"email": "noname@example.com", "password": "abcd"}},
    {"id": "put-users-2-valid", "method": "PUT", "path": "/users/2", "body": {"name": "Maria Updated", "active": true}},
    {"id": "put-users-missing", "method": "PUT", "path": "/users/9999", "body": {"name": "x"}},
    {"id": "delete-users-missing", "method": "DELETE", "path": "/users/9999"},
    {"id": "get-users-1-tasks", "method": "GET", "path": "/users/1/tasks"},
    {"id": "get-users-missing-tasks", "method": "GET", "path": "/users/9999/tasks"},
    {"id": "post-login-valid", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "password": "1234"}},
    {"id": "post-login-wrong-password", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "password": "wrong"}},
    {"id": "post-login-missing-fields", "method": "POST", "path": "/login", "body": {"email": "joao@email.com"}},
    {"id": "get-reports-summary-operator", "method": "GET", "path": "/reports/summary", "headers": {"X-Operator-Token": "probe-operator-token"}},
    {"id": "get-reports-user-1", "method": "GET", "path": "/reports/user/1"},
    {"id": "get-reports-user-missing", "method": "GET", "path": "/reports/user/9999"},
    {"id": "get-categories", "method": "GET", "path": "/categories"},
    {"id": "post-categories-valid", "method": "POST", "path": "/categories", "body": {"name": "Probe", "description": "d", "color": "#112233"}},
    {"id": "post-categories-missing-name", "method": "POST", "path": "/categories", "body": {"description": "no name"}},
    {"id": "put-categories-1-valid", "method": "PUT", "path": "/categories/1", "body": {"description": "updated"}},
    {"id": "put-categories-missing", "method": "PUT", "path": "/categories/9999", "body": {"name": "x"}},
    {"id": "delete-categories-missing", "method": "DELETE", "path": "/categories/9999"},
    {"id": "get-tasks-cors-origin", "method": "GET", "path": "/tasks", "headers": {"Origin": "http://example.com"}},
    {"id": "options-tasks-preflight", "method": "OPTIONS", "path": "/tasks",
     "headers": {"Origin": "http://example.com", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type"}},
    {"id": "delete-tasks-10", "method": "DELETE", "path": "/tasks/10", "destructive": true},
    {"id": "delete-users-3", "method": "DELETE", "path": "/users/3", "destructive": true},
    {"id": "delete-categories-4", "method": "DELETE", "path": "/categories/4", "destructive": true},
    {"id": "sec-search-priority-not-a-number", "method": "GET", "path": "/tasks/search?priority=abc",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-search-user-id-not-a-number", "method": "GET", "path": "/tasks/search?user_id=abc",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-tasks-priority-string", "method": "POST", "path": "/tasks", "body": {"title": "abc", "priority": "high"},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-tasks-title-number", "method": "POST", "path": "/tasks", "body": {"title": 12345},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-users-password-number", "method": "POST", "path": "/users",
     "body": {"name": "Num", "email": "num@example.com", "password": 12345},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-put-users-1-email-number", "method": "PUT", "path": "/users/1", "body": {"email": 12345},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-put-categories-1-null-body", "method": "PUT", "path": "/categories/1", "rawBody": "null",
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-get-reports-summary-anonymous", "method": "GET", "path": "/reports/summary",
     "kind": "security", "finding": "AP-04", "expect": "rejected"},
    {"id": "sec-post-tasks-tags-not-strings", "method": "POST", "path": "/tasks", "body": {"title": "abc", "tags": [1, 2]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-tasks-user-id-list", "method": "POST", "path": "/tasks", "body": {"title": "abc", "user_id": [1]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-tasks-category-id-list", "method": "POST", "path": "/tasks", "body": {"title": "abc", "category_id": [1]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-tasks-title-boolean", "method": "POST", "path": "/tasks", "body": {"title": true},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-put-tasks-1-tags-not-strings", "method": "PUT", "path": "/tasks/1", "body": {"tags": [1]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-put-tasks-1-user-id-list", "method": "PUT", "path": "/tasks/1", "body": {"user_id": [1]},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-put-tasks-1-priority-null", "method": "PUT", "path": "/tasks/1", "body": {"priority": null},
     "kind": "security", "finding": "AP-11", "expect": "rejected"},
    {"id": "sec-post-login-password-number", "method": "POST", "path": "/login", "body": {"email": "joao@email.com", "password": 123},
     "kind": "security", "finding": "AP-11", "expect": "rejected"}
  ]
}
