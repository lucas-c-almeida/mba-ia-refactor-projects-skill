# Copie para .env (não versionado) e ajuste. Nenhum valor abaixo é um segredo real.
DATABASE_URL=sqlite:///tasks.db
# Chave de assinatura do Flask. Se ausente, uma chave aleatória é gerada a cada processo.
SECRET_KEY=change-me
# Modo debug: desligado por padrão. NUNCA habilite em produção.
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
# Credencial das operações de operador (relatórios e remoção de usuário), enviada no header
# X-Operator-Token. Sem ela as três rotas respondem 403 (fechadas por padrão).
OPERATOR_TOKEN=
# Senha das contas criadas por seed.py. Sem ela, uma senha aleatória é gerada e exibida.
SEED_PASSWORD=
