# Every configuration key the application reads from the environment, with placeholders.
# Export them in your shell or deployment environment. Never commit real values.

# Required. Signing key for Flask sessions. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-random-secret>

# Optional (defaults shown).
DATABASE_URL=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
