# Copy to .env (never commit it) or export these in the environment before running.

# Required: session-signing key. Use a long random value.
SECRET_KEY=<generate-a-long-random-value>

# Optional (defaults shown)
DATABASE_URL=sqlite:///tasks.db
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
# Keeps the cross-origin behaviour the API had (answers private-network preflights).
# Setting it to false is the recommended hardening; see reports/audit-latest.md.
CORS_ALLOW_PRIVATE_NETWORK=true

# Required by seed.py only: passwords of the three seeded accounts.
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_USER_PASSWORD=<choose-a-password>
SEED_MANAGER_PASSWORD=<choose-a-password>
