# Copy to .env values into the environment; nothing here is a real secret.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///tasks.db
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
# Unset = privileged operations (GET /reports/summary, DELETE /users/<id>) answer 403.
# Set it and send it as the X-Operator-Token header to enable them.
OPERATOR_TOKEN=
# Required by seed.py only: password given to the example users.
SEED_USER_PASSWORD=change-me
