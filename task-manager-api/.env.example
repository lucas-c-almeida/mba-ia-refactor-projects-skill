# Copy to .env (loaded at startup through python-dotenv) or export these variables.
# Secrets are empty on purpose: an empty value means "not configured", and the feature it
# protects stays closed.

# Database (relative SQLite paths resolve inside <project>/instance/)
DATABASE_URL=sqlite:///tasks.db

# Flask signing key; empty leaves signed sessions disabled
SECRET_KEY=

# Credential for operator-only operations (X-Operator-Token header):
# GET /reports/summary, DELETE /users/<id>, and changing a user's role or active flag.
# Empty: those operations answer 403.
OPERATOR_TOKEN=

# Server
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# Cross-origin policy: * or a comma-separated list of origins
CORS_ORIGINS=*

# seed.py: password of each seeded account (empty: a random, unknown password)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_MANAGER_PASSWORD=
