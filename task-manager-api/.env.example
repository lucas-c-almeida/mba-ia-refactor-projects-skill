# Copy to .env (never commit the real file) and export these variables before running.
# Nothing in the code reads a .env file by itself: set them in the environment.

# Optional. Falls back to a per-process random value (the API keeps no sessions).
SECRET_KEY=change-me

# Optional. Defaults shown.
DATABASE_URI=sqlite:///tasks.db
APP_BIND=0.0.0.0
APP_PORT=5000
# Opt-in only: never enable in production (interactive debugger and reloader).
APP_DEBUG=false

# Optional. Credential for the operator-only report (GET /reports/summary, header X-Operator-Token).
# Unset by default: the report answers 403.
OPERATOR_TOKEN=

# Required by `python seed.py` (passwords of the seeded accounts).
SEED_ADMIN_PASSWORD=change-me
SEED_USER_PASSWORD=change-me
SEED_MANAGER_PASSWORD=change-me
