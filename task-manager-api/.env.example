# Copy to .env (never commit it) or export these variables before starting the app.
# Required
SECRET_KEY=<generate-a-long-random-value>
# Optional (defaults shown)
DATABASE_URL=sqlite:///tasks.db
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
CORS_ORIGINS=*
# Seed script only: passwords for the three sample accounts (random if unset)
SEED_ADMIN_PASSWORD=<choose-one>
SEED_USER_PASSWORD=<choose-one>
SEED_MANAGER_PASSWORD=<choose-one>
