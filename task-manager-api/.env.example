# Copy to .env (or set these as real environment variables) before running the app.
# Fixes AP-01 (SECRET_KEY was hardcoded) and documents every runtime setting AP-18
# moved out of source. See reports/audit-latest.md for the findings these resolve.

# Required. Flask's session/CSRF signing key. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Optional. Defaults to the original's sqlite:///tasks.db if unset.
DATABASE_URL=sqlite:///tasks.db

# Optional. Defaults to false (AP-18: the original always ran with debug=True).
# Never set to true on a host reachable from outside your own machine.
DEBUG=false

# Optional. Defaults to 0.0.0.0:5000, same as the original.
HOST=0.0.0.0
PORT=5000

# Optional. Defaults to "*", the ORIGINAL, unchanged behaviour (flask-cors' own
# wildcard default). Set a comma-separated allow-list in production — narrowing this
# default is proposed, not applied automatically; see reports/audit-latest.md (AP-18).
CORS_ORIGINS=*
