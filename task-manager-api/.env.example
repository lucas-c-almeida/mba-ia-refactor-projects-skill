# Copy to .env and adjust. Every key is optional; the defaults are safe.

# Signing key. Leave unset to get a random key per process (nothing here uses sessions today).
SECRET_KEY=

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///tasks.db

# Debug mode (interactive debugger, reloader). Keep it off anywhere reachable by others.
APP_DEBUG=false

# Bind address and port of the development server.
APP_HOST=0.0.0.0
APP_PORT=5000

# Cross-origin policy. CORS_ORIGINS is a comma-separated allow-list (empty means any origin, as before).
# Set CORS_ALLOW_PRIVATE_NETWORK=false to stop answering private-network preflights with "true".
CORS_ORIGINS=
CORS_ALLOW_PRIVATE_NETWORK=true

# Credential for operator-only routes (GET /reports/summary, DELETE /users/<id>).
# Send it in the X-Operator-Token header. Unset means those routes answer 403.
OPERATOR_TOKEN=

# Seed accounts (python seed.py). Unset means a random password is generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_MANAGER_PASSWORD=
