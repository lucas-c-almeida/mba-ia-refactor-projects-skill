{
  "version": 3,
  "appType": "http",
  "baseUrl": "http://127.0.0.1:3000",
  "entries": [
    {
      "id": "post-checkout-new-user",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Guilherme", "eml": "gui@fullcycle.com.br", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 2, "card": "4111222233334444" }
    },
    {
      "id": "post-checkout-existing-user",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Leonan", "eml": "leonan@fullcycle.com.br", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 2, "card": "4999888877776666" }
    },
    {
      "id": "post-checkout-no-password",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Maria", "eml": "maria@teste.com", "c_id": 1, "card": "4000111122223333" }
    },
    {
      "id": "post-checkout-denied",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Joao", "eml": "joao@teste.com", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 1, "card": "5111222233334444" }
    },
    {
      "id": "post-checkout-missing-fields",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": {}
    },
    {
      "id": "post-checkout-unknown-course",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Ana", "eml": "ana@teste.com", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 999, "card": "4111222233334444" }
    },
    {
      "id": "get-financial-report-operator",
      "method": "GET",
      "path": "/api/admin/financial-report",
      "headers": { "Accept": "application/json", "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" }
    },
    {
      "id": "get-financial-report-membership",
      "method": "GET",
      "path": "/api/admin/financial-report",
      "headers": { "Accept": "application/json", "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "kind": "value",
      "finding": "AP-10",
      "assert": [
        { "path": "$[*].course", "matches": "^(Clean Architecture|Docker)$" },
        { "path": "$[*].students[*].student", "matches": "^(Leonan|Guilherme|Maria|Ana|Bia|Robusta|Unknown)$" }
      ]
    },
    {
      "id": "delete-user-operator",
      "method": "DELETE",
      "path": "/api/users/2",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "destructive": true
    },
    {
      "id": "get-financial-report-anonymous",
      "method": "GET",
      "path": "/api/admin/financial-report",
      "headers": { "Accept": "application/json" },
      "kind": "security",
      "finding": "AP-04",
      "expect": "rejected"
    },
    {
      "id": "delete-user-anonymous",
      "method": "DELETE",
      "path": "/api/users/1",
      "kind": "security",
      "finding": "AP-04",
      "expect": "rejected",
      "destructive": true
    },
    {
      "id": "post-checkout-card-not-string",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Bia", "eml": "bia@teste.com", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 1, "card": 4111222233334444 },
      "kind": "security",
      "finding": "AP-11",
      "expect": "rejected",
      "destructive": true
    },
    {
      "id": "post-checkout-malformed-json",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "rawBody": "{\"usr\": ",
      "kind": "security",
      "finding": "AP-18",
      "expect": "rejected"
    },
    {
      "id": "post-checkout-robustness",
      "method": "POST",
      "path": "/api/checkout",
      "headers": { "Content-Type": "application/json" },
      "body": { "usr": "Robusta", "eml": "robust@teste.com", "pwd": "{{env:CHECKOUT_PASSWORD}}", "c_id": 2, "card": "4111222233334444" },
      "kind": "robustness",
      "finding": "AP-11",
      "fields": [
        { "in": "body", "name": "usr", "type": "string" },
        { "in": "body", "name": "eml", "type": "string" },
        { "in": "body", "name": "pwd", "type": "string" },
        { "in": "body", "name": "c_id", "type": "integer" },
        { "in": "body", "name": "card", "type": "string" }
      ]
    },
    {
      "id": "get-financial-report-robustness",
      "method": "GET",
      "path": "/api/admin/financial-report",
      "headers": { "Accept": "application/json", "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "kind": "robustness",
      "finding": "AP-11",
      "fields": [
        { "in": "header", "name": "X-Operator-Token", "type": "string" }
      ]
    },
    {
      "id": "delete-user-robustness",
      "method": "DELETE",
      "path": "/api/users/{id}",
      "headers": { "X-Operator-Token": "{{env:OPERATOR_TOKEN}}" },
      "kind": "robustness",
      "finding": "AP-11",
      "fields": [
        { "in": "path", "name": "id", "type": "integer", "value": 999 },
        { "in": "header", "name": "X-Operator-Token", "type": "string" }
      ]
    }
  ]
}
